{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schemas/attempt.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "attempt_id", "project", "module", "policy_profile", "baseline_digest", "digest"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "run_id": {"type": "string", "pattern": "^[0-9a-f]{32}$"},
    "attempt_id": {"type": "string", "pattern": "^[0-9a-f]{32}$"},
    "project": {"type": "string", "minLength": 1},
    "module": {"type": "string", "pattern": "^(?:\\.|(?!.*(?:^|/)\\.{1,2}(?:/|$))[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)*)$"},
    "policy_profile": {"enum": ["cases-only-v1", "local-pilot-v1"]},
    "baseline_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "parent_attempt_id": {"type": "string", "pattern": "^[0-9a-f]{32}$"},
    "retry_reason": {"$ref": "#/$defs/safe_label"},
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  },
  "$defs": {
    "safe_label": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$", "allOf": [{"not": {"pattern": "[tT][oO][kK][eE][nN]|[sS][eE][cC][rR][eE][tT]|[cC][rR][eE][dD][eE][nN][tT][iI][aA][lL]|[pP][aA][sS][sS][wW][oO][rR][dD]|[bB][eE][aA][rR][eE][rR]|[pP][rR][oO][mM][pP][tT]|[aA][pP][iI]_[kK][eE][yY]"}}, {"not": {"pattern": "^[gG][hH][pP]_|^[gG][iI][tT][hH][uU][bB]_[pP][aA][tT]_|^[sS][kK]-"}}, {"not": {"pattern": "^[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+$"}}, {"not": {"pattern": "^(?=.{24,}$)(?=.*[a-z])(?=.*[A-Z])(?=.*[0-9])[A-Za-z0-9_-]+$"}}]}
  },
  "allOf": [
    {"if": {"required": ["parent_attempt_id"]}, "then": {"required": ["retry_reason"]}},
    {"if": {"required": ["retry_reason"]}, "then": {"required": ["parent_attempt_id"]}}
  ]
}
