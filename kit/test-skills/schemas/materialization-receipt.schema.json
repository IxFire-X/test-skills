{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schemas/materialization-receipt.schema.json",
  "oneOf": [{"$ref": "#/$defs/file"}, {"$ref": "#/$defs/ownership"}],
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "file": {"type": "object", "additionalProperties": false, "required": ["file_id", "path", "content_digest", "baseline_digest", "automation_digest", "review_digest", "baseline_absent", "ownership_digest", "materialization"], "properties": {"file_id": {"type": "string", "pattern": "^FILE-[A-Za-z0-9_.:-]+$"}, "path": {"type": "string", "minLength": 1}, "content_digest": {"$ref": "#/$defs/digest"}, "baseline_digest": {"$ref": "#/$defs/digest"}, "automation_digest": {"$ref": "#/$defs/digest"}, "review_digest": {"$ref": "#/$defs/digest"}, "baseline_absent": {"const": true}, "ownership_digest": {"$ref": "#/$defs/digest"}, "materialization": {"enum": ["MATERIALIZED", "NOT_MATERIALIZED"]}, "disposition": {"enum": ["RETAINED", "CLEANED", "NOT_MATERIALIZED", "PRESERVED_EXECUTION_UNKNOWN", "PRESERVED_CONTENT_CONFLICT", "PRESERVED_CLEANUP_CONFLICT", "QUARANTINED"]}, "reason_code": {"type": "string", "minLength": 1}}},
    "ownership_file": {"type": "object", "additionalProperties": false, "required": ["file_id", "path", "content_digest", "baseline_absent", "ownership_digest"], "properties": {"file_id": {"type": "string", "pattern": "^FILE-[A-Za-z0-9_.:-]+$"}, "path": {"type": "string", "minLength": 1}, "content_digest": {"$ref": "#/$defs/digest"}, "baseline_absent": {"const": true}, "ownership_digest": {"$ref": "#/$defs/digest"}}},
    "ownership": {"type": "object", "additionalProperties": false, "required": ["schema_version", "stage", "module", "test_root", "baseline_digest", "automation_digest", "review_digest", "effective_canonical_digest", "effective_bundle_receipt_digest", "files"], "properties": {"schema_version": {"const": "1.0.0"}, "stage": {"const": "materialization-ownership"}, "module": {"type": "string", "minLength": 1}, "test_root": {"type": "string", "minLength": 1}, "baseline_digest": {"$ref": "#/$defs/digest"}, "automation_digest": {"$ref": "#/$defs/digest"}, "review_digest": {"$ref": "#/$defs/digest"}, "effective_canonical_digest": {"$ref": "#/$defs/digest"}, "effective_bundle_receipt_digest": {"$ref": "#/$defs/digest"}, "files": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/ownership_file"}}}}
  }
}
