{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schemas/reviewer-session.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "session_id", "review_key", "boundary_digest", "plan_digest", "events", "status", "digest"],
  "properties": {
    "schema_version": {"const": "2.0.0"},
    "session_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"},
    "review_key": {"enum": ["canonical", "r1", "r2"]},
    "boundary_digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "plan_digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "events": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["ordinal", "event_type"],
            "properties": {"ordinal": {"type": "integer", "minimum": 1}, "event_type": {"const": "REVIEW_SESSION_STARTED"}}
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["ordinal", "event_type", "verdict", "report_digest", "verdict_digest"],
            "properties": {
              "ordinal": {"type": "integer", "minimum": 1},
              "event_type": {"const": "AUTHORITATIVE_VERDICT"},
              "verdict": {"enum": ["ACCEPTED", "REJECTED"]},
              "report_digest": {"$ref": "#/$defs/digest"},
              "verdict_digest": {"$ref": "#/$defs/digest"}
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["ordinal", "event_type"],
            "properties": {"ordinal": {"type": "integer", "minimum": 1}, "event_type": {"const": "REVIEW_SESSION_COMPLETED"}}
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["ordinal", "event_type", "reason_code"],
            "properties": {"ordinal": {"type": "integer", "minimum": 1}, "event_type": {"const": "REVIEW_SESSION_ABORTED"}, "reason_code": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]*$"}}
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["ordinal", "event_type", "part"],
            "properties": {"ordinal": {"type": "integer", "minimum": 1}, "event_type": {"const": "REVIEW_CHECK_ADDED"}, "part": {"oneOf": [{"$ref": "review-plan.schema.json#/$defs/part"}, {"$ref": "review-plan-compact.schema.json#/$defs/part"}]}}
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["ordinal", "event_type", "part_id", "reason"],
            "properties": {
              "ordinal": {"type": "integer", "minimum": 1},
              "event_type": {"const": "REVIEW_PART_BLOCKED"},
              "part_id": {"type": "string", "pattern": "^part-[0-9]{6}$"},
              "reason": {"type": "string", "minLength": 1},
              "failure_class": {"enum": ["TRANSPORT", "CONTENT"]}
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["ordinal", "event_type", "part_id", "failed_try", "failure_class", "reason"],
            "properties": {
              "ordinal": {"type": "integer", "minimum": 1},
              "event_type": {"const": "REVIEW_PART_RETRY"},
              "part_id": {"type": "string", "pattern": "^part-[0-9]{6}$"},
              "failed_try": {"enum": [1, 2]},
              "failure_class": {"enum": ["TRANSPORT", "CONTENT"]},
              "reason": {"type": "string", "minLength": 1}
            }
          }
        ]
      }
    },
    "status": {"enum": ["WAITING", "COMPLETED", "ABORTED"]},
    "digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}
  },
  "$defs": {"digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}}
}
