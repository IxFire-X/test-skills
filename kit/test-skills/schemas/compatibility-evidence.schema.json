{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schemas/compatibility-evidence.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "compatibility_version", "release_manifest_digest", "host", "role_policy", "profile", "branch", "registry", "durable_context", "stages", "resume", "review_bindings", "digest"],
  "properties": {
    "schema_version": {"const": "2.0.0"}, "compatibility_version": {"const": "portable-cli-v1"},
    "release_manifest_digest": {"$ref": "#/$defs/digest"}, "role_policy": {"const": "portable-pilot-roles-v1"},
    "profile": {"enum": ["cases-only-v1", "local-pilot-v1"]}, "registry": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/file"}},
    "host": {"type": "object", "additionalProperties": false, "required": ["host_id", "runtime_version", "os", "language_runtime"], "properties": {"host_id": {"$ref": "#/$defs/nullable_label"}, "runtime_version": {"$ref": "#/$defs/nullable_label"}, "os": {"$ref": "#/$defs/nullable_label"}, "language_runtime": {"$ref": "#/$defs/nullable_label"}}},
    "durable_context": {"type": "object", "additionalProperties": false, "required": ["project", "run_id", "attempt_id", "module", "policy_profile", "baseline_digest", "reviewer_session_digest"], "properties": {"project": {"type": "string", "minLength": 1}, "run_id": {"$ref": "#/$defs/label"}, "attempt_id": {"type": "string", "pattern": "^[0-9a-f]{32}$"}, "module": {"oneOf": [{"const": "."}, {"$ref": "#/$defs/label"}]}, "policy_profile": {"enum": ["cases-only-v1", "local-pilot-v1"]}, "baseline_digest": {"$ref": "#/$defs/digest"}, "reviewer_session_digest": {"$ref": "#/$defs/digest"}}},
    "branch": {"type": "object", "additionalProperties": false, "required": ["canonical_status", "batch_ids", "automation_eligible", "automation_revisions"], "properties": {"canonical_status": {"const": "EFFECTIVE"}, "batch_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^BATCH-[a-z0-9-]+$"}}, "automation_eligible": {"type": "boolean"}, "automation_revisions": {"oneOf": [{"const": []}, {"const": [1]}, {"const": [1, 2]}]}}},
    "stages": {"type": "array", "minItems": 6, "items": {"oneOf": [{"$ref": "#/$defs/executed"}, {"$ref": "#/$defs/not_applicable"}]}},
    "resume": {"type": "object", "additionalProperties": false, "required": ["attempt_id", "resume_validation_digest"], "properties": {"attempt_id": {"type": "string", "pattern": "^[0-9a-f]{32}$"}, "resume_validation_digest": {"oneOf": [{"$ref": "#/$defs/digest"}, {"type": "null"}]}}},
    "review_bindings": {"type": "array", "minItems": 1, "items": {"oneOf": [{"$ref": "#/$defs/canonical"}, {"$ref": "#/$defs/automation"}]}}, "digest": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}, "label": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,255}$"}, "nullable_label": {"oneOf": [{"$ref": "#/$defs/label"}, {"type": "null"}]},
    "file": {"type": "object", "additionalProperties": false, "required": ["path", "digest"], "properties": {"path": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))[A-Za-z0-9._/-]+$"}, "digest": {"$ref": "#/$defs/digest"}}},
    "ref": {"type": "object", "additionalProperties": false, "required": ["kind", "digest"], "properties": {"kind": {"enum": ["attempt", "baseline", "model-stage-artifact", "effective-canonical", "reviewer-session", "execution-inputs", "automation-review-boundary-r1", "automation-review-boundary-r2"]}, "digest": {"$ref": "#/$defs/digest"}}},
    "executed": {"type": "object", "additionalProperties": false, "required": ["stage_instance_id", "stage", "status", "role", "role_policy", "model_id", "invocation_id", "input_digests", "output_digests", "artifact_ref"], "properties": {"stage_instance_id": {"$ref": "#/$defs/label"}, "stage": {"$ref": "#/$defs/label"}, "status": {"const": "EXECUTED"}, "role": {"$ref": "#/$defs/label"}, "role_policy": {"$ref": "#/$defs/label"}, "model_id": {"$ref": "#/$defs/nullable_label"}, "invocation_id": {"$ref": "#/$defs/nullable_label"}, "input_digests": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/digest"}}, "output_digests": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/digest"}}, "artifact_ref": {"$ref": "#/$defs/ref"}}},
    "not_applicable": {"type": "object", "additionalProperties": false, "required": ["stage_instance_id", "stage", "status", "reason_code", "branch_evidence_ref"], "properties": {"stage_instance_id": {"$ref": "#/$defs/label"}, "stage": {"$ref": "#/$defs/label"}, "status": {"const": "NOT_APPLICABLE"}, "reason_code": {"enum": ["PROFILE_CASES_ONLY", "CANONICAL_MANUAL_ONLY", "PRE_AUTOMATION_TERMINAL", "UNSUPPORTED_TUPLE"]}, "branch_evidence_ref": {"$ref": "#/$defs/ref"}}},
    "canonical": {"type":"object","additionalProperties":false,"required":["kind","generator_stage_instance_ids","reviewer_stage_instance_ids","reviewer_session_digest","reviewer_boundary_digest","review_aggregate_receipt_digest"],"properties":{"kind":{"const":"canonical"},"generator_stage_instance_ids":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","pattern":"^tc-generator:BATCH-[a-z0-9-]+$"}},"reviewer_session_digest":{"$ref":"#/$defs/digest"},"reviewer_boundary_digest":{"$ref":"#/$defs/digest"},"reviewer_stage_instance_ids":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","pattern":"^tc-reviewer:canonical:part-[0-9]{6}$"}},"review_aggregate_receipt_digest":{"$ref":"#/$defs/digest"}}},
    "automation": {"type":"object","additionalProperties":false,"required":["kind","revision","generator_stage_instance_id","reviewer_stage_instance_ids","reviewer_boundary_digest","review_aggregate_receipt_digest"],"properties":{"kind":{"const":"automation"},"revision":{"enum":[1,2]},"generator_stage_instance_id":{"$ref":"#/$defs/label"},"reviewer_boundary_digest":{"$ref":"#/$defs/digest"},"reviewer_stage_instance_ids":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","pattern":"^autotest-reviewer:r[12]:part-[0-9]{6}$"}},"review_aggregate_receipt_digest":{"$ref":"#/$defs/digest"}}}
  }
}
