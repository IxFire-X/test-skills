{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schemas/generated-delta.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "module", "test_root", "baseline_digest", "automation_digest", "review_digest", "effective_canonical_digest", "effective_bundle_receipt_digest", "files", "facts", "digest"],
  "properties": {
    "schema_version": {"const": "1.0.0"}, "module": {"type": "string", "minLength": 1}, "test_root": {"type": "string", "minLength": 1},
    "baseline_digest": {"$ref": "#/$defs/digest"}, "automation_digest": {"$ref": "#/$defs/digest"}, "review_digest": {"$ref": "#/$defs/digest"}, "effective_canonical_digest": {"$ref": "#/$defs/digest"}, "effective_bundle_receipt_digest": {"$ref": "#/$defs/digest"},
    "files": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/file"}}, "facts": {"oneOf": [{"$ref": "#/$defs/complete_facts"}, {"$ref": "#/$defs/partial_facts"}]}, "digest": {"$ref": "#/$defs/digest"}
  },
  "allOf": [
    {"if": {"properties": {"facts": {"properties": {"completion": {"const": "COMPLETE"}}}}}, "then": {"properties": {"files": {"items": {"properties": {"materialization": {"const": "MATERIALIZED"}}}}}}},
    {"if": {"properties": {"facts": {"properties": {"completion": {"const": "PARTIAL"}}}}}, "then": {"properties": {"files": {"contains": {"properties": {"materialization": {"const": "NOT_MATERIALIZED"}}}}}}}
  ],
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "file": {"type": "object", "additionalProperties": false, "required": ["file_id", "path", "content_digest", "baseline_digest", "automation_digest", "review_digest", "baseline_absent", "ownership_digest", "materialization"], "properties": {"file_id": {"type": "string", "pattern": "^FILE-[A-Za-z0-9_.:-]+$"}, "path": {"type": "string", "minLength": 1}, "content_digest": {"$ref": "#/$defs/digest"}, "baseline_digest": {"$ref": "#/$defs/digest"}, "automation_digest": {"$ref": "#/$defs/digest"}, "review_digest": {"$ref": "#/$defs/digest"}, "baseline_absent": {"const": true}, "ownership_digest": {"$ref": "#/$defs/digest"}, "materialization": {"enum": ["MATERIALIZED", "NOT_MATERIALIZED"]}}},
    "complete_facts": {"type": "object", "additionalProperties": false, "required": ["completion", "verification", "accepted"], "properties": {"completion": {"const": "COMPLETE"}, "verification": {"const": null}, "accepted": {"const": null}}},
    "partial_facts": {"type": "object", "additionalProperties": false, "required": ["completion", "verification", "reason_code", "accepted"], "properties": {"completion": {"const": "PARTIAL"}, "verification": {"const": "NOT_APPLICABLE"}, "reason_code": {"const": "MATERIALIZATION_INCOMPLETE"}, "accepted": {"const": false}}}
  }
}
