{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"schemas/inventory-receipt.schema.json","type":"object","additionalProperties":false,"required":["schema_version","project","project_identity","module","files","exclusions","digest"],"properties":{"schema_version":{"const":"1.0.0"},"project":{"type":"string","minLength":1},"project_identity":{"type":"string","pattern":"^project-[a-f0-9]{24}$"},"module":{"type":"string","minLength":1},"files":{"type":"array","items":{"type":"object","additionalProperties":false,"required":["opaque_id","project_path","kind","language","size","content_digest"],"properties":{"opaque_id":{"type":"string","pattern":"^file-[a-f0-9]{24}$"},"project_path":{"type":"string","pattern":"^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$)).+$"},"kind":{"enum":["source","test","config","fixture","resource"]},"language":{"type":"string","minLength":1},"size":{"type":"integer","minimum":0},"content_digest":{"type":"string","pattern":"^sha256:[a-f0-9]{64}$"},"redactions":{"type":"array","minItems":1,"items":{"type":"object","additionalProperties":false,"required":["line","scanner_rule_id"],"properties":{"line":{"type":"integer","minimum":1},"scanner_rule_id":{"type":"string","pattern":"^[a-z0-9][a-z0-9-]{0,63}$"}}}}}}},"exclusions":{"type":"array","items":{"$ref":"exclusion-receipt.schema.json#/$defs/exclusion"}},"digest":{"type":"string","pattern":"^sha256:[a-f0-9]{64}$"}}}
