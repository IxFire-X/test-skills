# Обычно этот файл создаёт tools/init_skillsrc.py.
# Редактируйте подтверждённые значения; при конфликте следующий запуск покажет diff.
schema_version: "5.0.0"
version: "3.0"

project:
  name: "example-workspace"
  methodology: "sdd"

discovery:
  on_missing: "automatic"
  conflict_policy: "ask_user"

modules:
  - id: "backend"
    root: "backend"
    stack:
      language: "python"
      build_tool: "pip"
    paths:
      source: ["src"]
      tests: ["tests"]
    test:
      framework: "pytest"
      adapter_id: "pytest:selected-symbols-v1"
      interpreter: ".venv/Scripts/python.exe"
      build_profile: "default"
      adapter_parameters: {}
    feature_sources:
      requirements: ["docs/requirements"]
    detected_from: ["backend/pyproject.toml"]

  - id: "frontend"
    root: "frontend"
    stack:
      language: "typescript"
      build_tool: "npm"
    paths:
      source: ["src"]
      tests: ["tests"]
    feature_sources:
      requirements: ["docs/requirements"]
    detected_from: ["frontend/package.json"]
