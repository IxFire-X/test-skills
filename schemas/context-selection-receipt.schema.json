{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"schemas/context-selection-receipt.schema.json","type":"object","additionalProperties":false,"required":["schema_version","inventory_digest","batch_index","files","byte_count","byte_set_digest","digest"],"properties":{"schema_version":{"const":"1.0.0"},"inventory_digest":{"type":"string","pattern":"^sha256:[a-f0-9]{64}$"},"batch_index":{"type":"integer","minimum":1},"files":{"type":"array","items":{"type":"object","additionalProperties":false,"required":["opaque_id","project_path","content_digest","size"],"properties":{"opaque_id":{"type":"string","pattern":"^file-[a-f0-9]{24}$"},"project_path":{"type":"string","minLength":1},"content_digest":{"type":"string","pattern":"^sha256:[a-f0-9]{64}$"},"size":{"type":"integer","minimum":0}}}},"byte_count":{"type":"integer","minimum":0},"skipped":{"description":"FaT-A: files kept out of the model context, with the reason; only in the first batch","type":"array","minItems":1,"items":{"type":"object","additionalProperties":false,"required":["project_path","size","reason","rule"],"properties":{"project_path":{"type":"string","minLength":1},"size":{"type":"integer","minimum":0},"reason":{"enum":["CONTEXT_EXCLUDED_BY_USER","CONTEXT_ASSET","CONTEXT_TOO_LARGE"]},"rule":{"type":"string","minLength":1,"maxLength":300}}}},"byte_set_digest":{"type":"string","pattern":"^sha256:[a-f0-9]{64}$"},"digest":{"type":"string","pattern":"^sha256:[a-f0-9]{64}$"}}}
