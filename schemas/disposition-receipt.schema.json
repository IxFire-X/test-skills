{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schemas/disposition-receipt.schema.json",
  "oneOf": [{"$ref": "#/$defs/file"}, {"$ref": "#/$defs/plan"}, {"$ref": "#/$defs/final"}],
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "file_id": {"type": "string", "pattern": "^FILE-[A-Za-z0-9_.:-]+$"},
    "disposition": {"enum": ["RETAINED", "CLEANED", "NOT_MATERIALIZED", "PRESERVED_EXECUTION_UNKNOWN", "PRESERVED_CONTENT_CONFLICT", "PRESERVED_CLEANUP_CONFLICT", "QUARANTINED"]},
    "file": {"type": "object", "additionalProperties": false, "required": ["file_id", "path", "content_digest", "baseline_digest", "automation_digest", "review_digest", "disposition"], "properties": {"file_id": {"$ref": "#/$defs/file_id"}, "path": {"type": "string", "minLength": 1}, "content_digest": {"$ref": "#/$defs/digest"}, "baseline_digest": {"$ref": "#/$defs/digest"}, "automation_digest": {"$ref": "#/$defs/digest"}, "review_digest": {"$ref": "#/$defs/digest"}, "materialization": {"enum": ["MATERIALIZED", "NOT_MATERIALIZED"]}, "disposition": {"$ref": "#/$defs/disposition"}, "reason_code": {"type": "string", "minLength": 1}}},
    "plan_row": {"type": "object", "additionalProperties": false, "required": ["file_id", "path", "content_digest", "materialization", "ownership_digest", "baseline_absent", "operation", "requested_disposition", "pre_effect_state"], "properties": {"file_id": {"$ref": "#/$defs/file_id"}, "path": {"type": "string", "minLength": 1}, "content_digest": {"$ref": "#/$defs/digest"}, "materialization": {"enum": ["MATERIALIZED", "NOT_MATERIALIZED"]}, "ownership_digest": {"$ref": "#/$defs/digest"}, "baseline_absent": {"const": true}, "operation": {"enum": ["RETAIN_IF_EXACT", "CLEAN_IF_EXACT", "PRESERVE_UNKNOWN", "NO_FILE", "QUARANTINE_IF_EXACT"]}, "requested_disposition": {"$ref": "#/$defs/disposition"}, "pre_effect_state": {"enum": ["EXACT", "MISSING", "DRIFT", "UNSAFE", "NOT_APPLICABLE"]}, "quarantine_symbols": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^SYMBOL-[A-Za-z0-9_.:-]+$"}, "description": "Failed methods the quarantine policy marks (contract amendment A4)."}, "quarantined_content_digest": {"$ref": "#/$defs/digest"}}, "allOf": [{"if": {"properties": {"operation": {"const": "QUARANTINE_IF_EXACT"}}}, "then": {"required": ["quarantine_symbols"]}, "else": {"not": {"anyOf": [{"required": ["quarantine_symbols"]}, {"required": ["quarantined_content_digest"]}]}}}]},
    "final_row": {"type": "object", "additionalProperties": false, "required": ["file_id", "path", "content_digest", "materialization", "ownership_digest", "baseline_absent", "disposition"], "properties": {"file_id": {"$ref": "#/$defs/file_id"}, "path": {"type": "string", "minLength": 1}, "content_digest": {"$ref": "#/$defs/digest"}, "materialization": {"enum": ["MATERIALIZED", "NOT_MATERIALIZED"]}, "ownership_digest": {"$ref": "#/$defs/digest"}, "baseline_absent": {"const": true}, "disposition": {"$ref": "#/$defs/disposition"}, "reason_code": {"type": "string", "minLength": 1}}, "allOf": [{"if": {"properties": {"disposition": {"enum": ["PRESERVED_EXECUTION_UNKNOWN", "PRESERVED_CONTENT_CONFLICT", "PRESERVED_CLEANUP_CONFLICT"]}}}, "then": {"required": ["reason_code"]}}]},
    "plan": {"type": "object", "additionalProperties": false, "required": ["schema_version", "stage", "generated_delta_digest", "verification", "files", "digest"], "properties": {"schema_version": {"const": "1.0.0"}, "stage": {"const": "disposition-plan"}, "generated_delta_digest": {"$ref": "#/$defs/digest"}, "verification": {"enum": ["PASS", "FAIL", "UNKNOWN", "NOT_RUNNABLE", "NOT_APPLICABLE"]}, "execution_unknown_evidence_digest": {"$ref": "#/$defs/digest"}, "files": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/plan_row"}}, "digest": {"$ref": "#/$defs/digest"}}, "allOf": [{"if": {"properties": {"verification": {"const": "UNKNOWN"}}}, "then": {"required": ["execution_unknown_evidence_digest"]}, "else": {"not": {"required": ["execution_unknown_evidence_digest"]}}}]},
    "final": {"type": "object", "additionalProperties": false, "required": ["schema_version", "stage", "disposition_plan_digest", "generated_delta_digest", "verification", "files", "digest"], "properties": {"schema_version": {"const": "1.0.0"}, "stage": {"const": "dispositions"}, "disposition_plan_digest": {"$ref": "#/$defs/digest"}, "generated_delta_digest": {"$ref": "#/$defs/digest"}, "verification": {"enum": ["PASS", "FAIL", "UNKNOWN", "NOT_RUNNABLE", "NOT_APPLICABLE"]}, "execution_unknown_evidence_digest": {"$ref": "#/$defs/digest"}, "files": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/final_row"}}, "digest": {"$ref": "#/$defs/digest"}}, "allOf": [{"if": {"properties": {"verification": {"const": "UNKNOWN"}}}, "then": {"required": ["execution_unknown_evidence_digest"]}, "else": {"not": {"required": ["execution_unknown_evidence_digest"]}}}]}
  }
}
