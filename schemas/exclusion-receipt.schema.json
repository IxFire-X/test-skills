{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"schemas/exclusion-receipt.schema.json","type":"object","additionalProperties":false,"required":["schema_version","exclusions","digest"],"properties":{"schema_version":{"const":"1.0.0"},"exclusions":{"type":"array","items":{"$ref":"#/$defs/exclusion"}},"digest":{"type":"string","pattern":"^sha256:[a-f0-9]{64}$"}},"$defs":{"exclusion":{"type":"object","additionalProperties":false,"required":["project_path","reason_code","scanner_rule_id","safe_label"],"properties":{"project_path":{"type":"string","pattern":"^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$)).+$"},"reason_code":{"enum":["BINARY_OR_GENERATED","BUILD_OUTPUT","DEPENDENCY","EXCLUDED_DIRECTORY","REPARSE_ESCAPE","SECRET_SUSPECTED","SKILL_PACK","UNREADABLE","VCS"]},"scanner_rule_id":{"type":"string","pattern":"^[a-z0-9][a-z0-9-]{0,63}$"},"safe_label":{"type":"string","pattern":"^[a-z0-9][a-z0-9-]{0,63}$"}}}}}
