{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schemas/trace-document.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "stage", "source", "automation_sha256", "autotest_review_sha256", "automation_status", "requirements", "test_cases", "steps", "expectations", "assertions", "files", "symbols", "implementation_relations", "manual_dispositions", "automation_diagnostics", "execution", "lifecycle"],
  "properties": {
    "schema_version": {"const": "5.0.0"}, "stage": {"const": "trace"}, "source": {"$ref": "#/$defs/source"},
    "automation_sha256": {"$ref": "#/$defs/digest"}, "autotest_review_sha256": {"$ref": "#/$defs/digest"},
    "automation_status": {"enum": ["GENERATED", "BLOCKED"]},
    "requirements": {"type": "array", "items": {"$ref": "#/$defs/requirement"}}, "test_cases": {"type": "array", "items": {"$ref": "#/$defs/test_case"}},
    "steps": {"type": "array", "items": {"$ref": "#/$defs/step"}}, "expectations": {"type": "array", "items": {"$ref": "#/$defs/expectation"}},
    "assertions": {"type": "array", "items": {"$ref": "#/$defs/assertion"}}, "files": {"type": "array", "items": {"$ref": "#/$defs/file"}},
    "symbols": {"type": "array", "items": {"$ref": "#/$defs/symbol"}}, "implementation_relations": {"type": "array", "items": {"oneOf": [{"$ref": "#/$defs/operation_relation"}, {"$ref": "#/$defs/assertion_relation"}]}},
    "manual_dispositions": {"type": "array", "items": {"$ref": "#/$defs/manual"}}, "automation_diagnostics": {"type": "array", "items": {"$ref": "#/$defs/diagnostic"}},
    "execution": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/execution"}]}, "lifecycle": {"$ref": "#/$defs/lifecycle"}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}, "id": {"type": "string", "minLength": 1},
    "source": {"type": "object", "additionalProperties": false, "required": ["document_id", "revision", "source_digest"], "properties": {"document_id": {"type": "string", "pattern": "^TCDOC-[a-z0-9](?:[a-z0-9_.-]*[a-z0-9_-])?$"}, "revision": {"type": "integer", "minimum": 1}, "source_digest": {"$ref": "#/$defs/digest"}}},
    "requirement": {"type": "object", "additionalProperties": false, "required": ["requirement_id", "display_order"], "properties": {"requirement_id": {"type": "string", "pattern": "^CREQ-[A-Za-z0-9_.:-]+$"}, "display_order": {"type": "integer", "minimum": 1}}},
    "test_case": {"type": "object", "additionalProperties": false, "required": ["case_id", "display_order", "requirement_ids"], "properties": {"case_id": {"type": "string", "pattern": "^TC-[A-Za-z0-9_.:-]+$"}, "display_order": {"type": "integer", "minimum": 1}, "requirement_ids": {"type": "array", "items": {"type": "string", "pattern": "^CREQ-[A-Za-z0-9_.:-]+$"}}}},
    "step": {"type": "object", "additionalProperties": false, "required": ["case_id", "step_id", "display_order", "manual_only", "blocker_ids"], "properties": {"case_id": {"type": "string", "pattern": "^TC-[A-Za-z0-9_.:-]+$"}, "step_id": {"type": "string", "pattern": "^STEP-[A-Za-z0-9_.:-]+$"}, "display_order": {"type": "integer", "minimum": 1}, "manual_only": {"type": "boolean"}, "blocker_ids": {"type": "array", "items": {"type": "string", "pattern": "^BLOCK-[A-Za-z0-9_.:-]+$"}}}},
    "expectation": {"type": "object", "additionalProperties": false, "required": ["case_id", "step_id", "expectation_id", "display_order"], "properties": {"case_id": {"type": "string", "pattern": "^TC-[A-Za-z0-9_.:-]+$"}, "step_id": {"type": "string", "pattern": "^STEP-[A-Za-z0-9_.:-]+$"}, "expectation_id": {"type": "string", "pattern": "^EXP-[A-Za-z0-9_.:-]+$"}, "display_order": {"type": "integer", "minimum": 1}}},
    "assertion": {"type": "object", "additionalProperties": false, "required": ["case_id", "step_id", "expectation_id", "assertion_id", "display_order"], "properties": {"case_id": {"type": "string", "pattern": "^TC-[A-Za-z0-9_.:-]+$"}, "step_id": {"type": "string", "pattern": "^STEP-[A-Za-z0-9_.:-]+$"}, "expectation_id": {"type": "string", "pattern": "^EXP-[A-Za-z0-9_.:-]+$"}, "assertion_id": {"type": "string", "pattern": "^ASSERT-[A-Za-z0-9_.:-]+$"}, "display_order": {"type": "integer", "minimum": 1}}},
    "file": {"type": "object", "additionalProperties": false, "required": ["file_id", "path", "language", "framework", "file_digest"], "properties": {"file_id": {"type": "string", "pattern": "^FILE-[A-Za-z0-9_.:-]+$"}, "path": {"type": "string", "minLength": 1}, "language": {"enum": ["python", "java"]}, "framework": {"type": "string", "minLength": 1}, "file_digest": {"$ref": "#/$defs/digest"}}},
    "locator": {"oneOf": [{"type": "object", "additionalProperties": false, "required": ["kind", "function_name"], "properties": {"kind": {"const": "python_module_function"}, "function_name": {"type": "string", "minLength": 1}}}, {"type": "object", "additionalProperties": false, "required": ["kind", "qualified_class_name", "method_name"], "properties": {"kind": {"const": "python_class_method"}, "qualified_class_name": {"type": "string", "minLength": 1}, "method_name": {"type": "string", "minLength": 1}}}, {"type": "object", "additionalProperties": false, "required": ["kind", "class_fqn", "method_name"], "properties": {"kind": {"const": "java_class_method"}, "class_fqn": {"type": "string", "minLength": 1}, "method_name": {"type": "string", "minLength": 1}}}]},
    "symbol": {"type": "object", "additionalProperties": false, "required": ["file_id", "symbol_id", "locator"], "properties": {"file_id": {"type": "string", "pattern": "^FILE-[A-Za-z0-9_.:-]+$"}, "symbol_id": {"type": "string", "pattern": "^SYMBOL-[A-Za-z0-9_.:-]+$"}, "locator": {"$ref": "#/$defs/locator"}}},
    "operation_relation": {"type": "object", "additionalProperties": false, "required": ["kind", "case_id", "step_id", "file_id", "symbol_id"], "properties": {"kind": {"const": "operation"}, "case_id": {"type": "string", "pattern": "^TC-[A-Za-z0-9_.:-]+$"}, "step_id": {"type": "string", "pattern": "^STEP-[A-Za-z0-9_.:-]+$"}, "file_id": {"type": "string", "pattern": "^FILE-[A-Za-z0-9_.:-]+$"}, "symbol_id": {"type": "string", "pattern": "^SYMBOL-[A-Za-z0-9_.:-]+$"}}},
    "assertion_relation": {"type": "object", "additionalProperties": false, "required": ["kind", "case_id", "step_id", "expectation_id", "assertion_id", "file_id", "symbol_id"], "properties": {"kind": {"const": "assertion"}, "case_id": {"type": "string", "pattern": "^TC-[A-Za-z0-9_.:-]+$"}, "step_id": {"type": "string", "pattern": "^STEP-[A-Za-z0-9_.:-]+$"}, "expectation_id": {"type": "string", "pattern": "^EXP-[A-Za-z0-9_.:-]+$"}, "assertion_id": {"type": "string", "pattern": "^ASSERT-[A-Za-z0-9_.:-]+$"}, "file_id": {"type": "string", "pattern": "^FILE-[A-Za-z0-9_.:-]+$"}, "symbol_id": {"type": "string", "pattern": "^SYMBOL-[A-Za-z0-9_.:-]+$"}}},
    "manual": {"type": "object", "additionalProperties": false, "required": ["case_id", "step_id"], "properties": {"case_id": {"type": "string"}, "step_id": {"type": "string"}}}, "diagnostic": {"type": "object", "additionalProperties": false, "required": ["path", "code", "message"], "properties": {"path": {"type": "string"}, "code": {"type": "string", "minLength": 1}, "message": {"type": "string", "minLength": 1}}},
    "evidence": {"type": "object", "additionalProperties": false, "required": ["run_id", "source_digest", "file_id", "symbol_id", "file_digest", "status"], "properties": {"run_id": {"type": "string", "pattern": "^RUN-[A-Za-z0-9_.:-]+$"}, "source_digest": {"$ref": "#/$defs/digest"}, "file_id": {"type": "string"}, "symbol_id": {"type": "string"}, "file_digest": {"$ref": "#/$defs/digest"}, "status": {"enum": ["PASSED", "FAILED", "ERROR", "SKIPPED"]}}},
    "process_evidence": {"type": "object", "additionalProperties": false, "required": ["run_id", "source_digest", "kind", "error_class", "exit_cause", "command_profile", "duration_sec", "stdout_tail", "stderr_tail"], "properties": {"run_id": {"type": "string", "pattern": "^RUN-[A-Za-z0-9_.:-]+$"}, "source_digest": {"$ref": "#/$defs/digest"}, "kind": {"enum": ["TIMEOUT", "OS_ERROR", "COLLECTION_ERROR", "EXECUTION_ERROR", "JUNIT_MISSING", "JUNIT_INVALID", "SOURCE_CHANGED", "BASELINE_DRIFT", "NO_TESTS_COLLECTED"]}, "error_class": {"enum": ["TimeoutExpired", "OSError", "CollectionError", "ExecutionError", "JUnitMissing", "ParseError", "SourceChanged", "BaselineDrift", "NoTestsCollected"]}, "exit_cause": {"enum": ["TIMEOUT", "OS_ERROR", "NONZERO_EXIT", "ZERO_EXIT"]}, "command_profile": {"enum": ["pytest:selected-symbols-v1", "maven-wrapper:selected-symbols-v1", "maven:selected-symbols-v1", "gradle-wrapper:selected-symbols-v1"]}, "duration_sec": {"type": "number", "minimum": 0}, "stdout_tail": {"type": "string", "maxLength": 2000}, "stderr_tail": {"type": "string", "maxLength": 2000}, "affected_file_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^FILE-[A-Za-z0-9_.:-]+$"}}}, "allOf": [{"if": {"properties": {"kind": {"const": "SOURCE_CHANGED"}}, "required": ["kind"]}, "then": {"required": ["affected_file_ids"]}}, {"if": {"properties": {"kind": {"not": {"const": "SOURCE_CHANGED"}}}, "required": ["kind"]}, "then": {"not": {"required": ["affected_file_ids"]}}}]},
    "execution_target": {"type": "object", "additionalProperties": false, "required": ["runner", "command"], "properties": {"runner": {"enum": ["pytest", "maven", "gradle", "not_applicable"]}, "command": {"type": ["string", "null"]}}},
    "execution": {"type": "object", "additionalProperties": false, "required": ["verdict", "run_id", "evidence_authoritative", "evidence", "process_evidence"], "properties": {"verdict": {"enum": ["PASS", "FAIL", "UNKNOWN", "NOT_RUNNABLE"]}, "run_id": {"type": ["string", "null"], "pattern": "^RUN-[A-Za-z0-9_.:-]+$"}, "evidence_authoritative": {"type": "boolean"}, "evidence": {"type": "array", "items": {"$ref": "#/$defs/evidence"}}, "process_evidence": {"type": "array", "maxItems": 2, "items": {"$ref": "#/$defs/process_evidence"}, "allOf": [{"contains": {"properties": {"kind": {"const": "SOURCE_CHANGED"}}, "required": ["kind"]}, "minContains": 0, "maxContains": 1}, {"contains": {"properties": {"kind": {"not": {"const": "SOURCE_CHANGED"}}}, "required": ["kind"]}, "minContains": 0, "maxContains": 1}]}, "exit_code": {"type": "integer"}, "duration_sec": {"type": "number", "minimum": 0}, "target": {"$ref": "#/$defs/execution_target"}}, "allOf": [{"if": {"properties": {"run_id": {"type": "null"}}, "required": ["run_id"]}, "then": {"properties": {"verdict": {"const": "NOT_RUNNABLE"}, "evidence_authoritative": {"const": false}, "evidence": {"maxItems": 0}, "process_evidence": {"maxItems": 0}}}}, {"if": {"properties": {"verdict": {"const": "PASS"}}, "required": ["verdict"]}, "then": {"properties": {"run_id": {"type": "string"}, "evidence_authoritative": {"const": true}, "evidence": {"minItems": 1}, "process_evidence": {"maxItems": 0}}}}, {"if": {"properties": {"verdict": {"const": "UNKNOWN"}}, "required": ["verdict"]}, "then": {"properties": {"run_id": {"type": "string"}, "evidence_authoritative": {"const": false}}}}, {"if": {"properties": {"process_evidence": {"minItems": 1}}, "required": ["process_evidence"]}, "then": {"required": ["exit_code", "duration_sec", "target"]}}]},
    "lifecycle": {"type": "object", "additionalProperties": false, "required": ["projection", "verification"], "properties": {"projection": {"const": "PRE_FINALIZATION"}, "verification": {"enum": ["PASS", "FAIL", "UNKNOWN", "NOT_RUNNABLE", "NOT_APPLICABLE"]}}}
  }
}
