{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schemas/release-eval-run.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "campaign_id", "suite_id", "suite_digest", "scenario_id", "run_id", "attempt_id", "sequence", "kind", "compatibility_evidence", "scenario_checks", "digest"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "campaign_id": {"$ref": "#/$defs/label"},
    "suite_id": {"const": "pilot-critical-v1"},
    "suite_digest": {"$ref": "#/$defs/digest"},
    "scenario_id": {"$ref": "#/$defs/label"},
    "run_id": {"type": "string", "pattern": "^[0-9a-f]{32}$"},
    "attempt_id": {"type": "string", "pattern": "^[0-9a-f]{32}$"},
    "sequence": {"type": "integer", "minimum": 1},
    "kind": {"enum": ["smoke", "critical"]},
    "compatibility_evidence": {"$ref": "#/$defs/ref"},
    "scenario_checks": {
      "type": "array", "minItems": 1, "maxItems": 1, "uniqueItems": true,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["check_id", "evidence_digests"],
        "properties": {
          "check_id": {"$ref": "#/$defs/label"},
          "evidence_digests": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/digest"}}
        }
      }
    },
    "scenario_observation_receipt_digest": {"$ref": "#/$defs/digest"},
    "digest": {"$ref": "#/$defs/digest"}
  },
  "allOf": [{
    "if": {
      "properties": {
        "scenario_id": {"enum": ["fresh-non-git", "dirty-git-preservation", "waiting-for-model-resume", "one-user-question-resume", "terminal-idempotent-retry", "retained-native-rerun"]}
      },
      "required": ["scenario_id"]
    },
    "then": {"required": ["scenario_observation_receipt_digest"]}
  }],
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "label": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,255}$"},
    "ref": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "digest"],
      "properties": {
        "path": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))[A-Za-z0-9._/-]+\\.json$"},
        "digest": {"$ref": "#/$defs/digest"}
      }
    }
  }
}
