{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schemas/release-manifest.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "package_version", "skill_pack_digest", "pipeline_contract", "compatibility_contract_version", "execution_profile_version", "policy_profiles", "adapter_registry", "stage_registry", "projection_profiles", "release_eval", "registry", "qualification", "digest"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "package_version": {"const": "0.5.0-pilot"},
    "skill_pack_digest": {"$ref": "#/$defs/digest"},
    "pipeline_contract": {
      "type": "object", "additionalProperties": false,
      "required": ["version", "path", "digest"],
      "properties": {"version": {"const": "4.0"}, "path": {"const": "contracts/pipeline.json"}, "digest": {"$ref": "#/$defs/digest"}}
    },
    "compatibility_contract_version": {"const": "portable-cli-v1"},
    "execution_profile_version": {"const": "v1"},
    "policy_profiles": {"type": "array", "minItems": 2, "uniqueItems": true, "items": {"$ref": "#/$defs/versioned_id"}},
    "adapter_registry": {"type": "array", "minItems": 3, "uniqueItems": true, "items": {"$ref": "#/$defs/versioned_id"}},
    "stage_registry": {"type": "array", "minItems": 6, "maxItems": 6, "uniqueItems": true, "items": {"$ref": "#/$defs/stage"}},
    "projection_profiles": {"type": "array", "minItems": 3, "maxItems": 3, "uniqueItems": true, "items": {"$ref": "#/$defs/projection_profile"}},
    "release_eval": {
      "type": "object", "additionalProperties": false,
      "required": ["suite_id", "suite_digest", "policy"],
      "properties": {"suite_id": {"const": "pilot-critical-v1"}, "suite_digest": {"$ref": "#/$defs/digest"}, "policy": {"const": "adaptive-1-3-5-v1"}}
    },
    "registry": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/file"}},
    "qualification": {
      "type": "object", "additionalProperties": false,
      "required": ["state", "ready_tuple"],
      "properties": {"state": {"const": "implemented_unverified"}, "ready_tuple": {"const": null}}
    },
    "digest": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "label": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,255}$"},
    "versioned_id": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {"id": {"$ref": "#/$defs/label"}, "version": {"$ref": "#/$defs/label"}}
    },
    "file": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "digest"],
      "properties": {"path": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))[A-Za-z0-9._/-]+$"}, "digest": {"$ref": "#/$defs/digest"}}
    },
    "stage": {
      "type": "object", "additionalProperties": false,
      "required": ["stage", "role", "role_policy", "cardinality", "profiles"],
      "properties": {
        "stage": {"$ref": "#/$defs/label"}, "role": {"$ref": "#/$defs/label"}, "role_policy": {"$ref": "#/$defs/label"},
        "cardinality": {"enum": ["once", "per_batch", "per_review_part", "per_automation_revision"]},
        "profiles": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["cases-only-v1", "local-pilot-v1"]}}
      }
    },
    "projection_profile": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "format", "mode", "tenant_status"],
      "properties": {
        "id": {"enum": ["zephyr-scale-step-row-24-v5", "zephyr-scale-step-row-24-v4", "zephyr-scale-xml-observed-v1"]},
        "format": {"enum": ["csv", "xml"]},
        "mode": {"enum": ["default", "opt_in_compatibility", "opt_in_observed"]},
        "tenant_status": {"const": "N_A"}
      }
    }
  }
}
