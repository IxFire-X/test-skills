{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schemas/model-request.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "attempt_id",
    "stage_instance_id",
    "stage",
    "role",
    "role_policy",
    "model_id",
    "invocation_id",
    "input_digests",
    "digest"
  ],
  "properties": {
    "schema_version": {"enum": ["1.0.0", "1.1.0"], "description": "FaT-CR: 1.1.0 adds skill_pack_digest and reuse (context-marker)."},
    "run_id": {"type": "string", "pattern": "^[0-9a-f]{32}$"},
    "attempt_id": {"type": "string", "pattern": "^[0-9a-f]{32}$"},
    "stage_instance_id": {"type": "string", "pattern": "^(?:context-marker:(?:baseline|requirements|batch-[0-9]{3})|tc-generator:BATCH-[a-z0-9-]+|tc-reviewer:canonical|tc-to-autotest:r[12]|autotest-reviewer:r[12])$"},
    "stage": {"enum": ["context-marker", "tc-generator", "tc-reviewer", "tc-to-autotest", "autotest-reviewer"]},
    "role": {"enum": ["generator", "canonical-reviewer", "automation-generator", "automation-reviewer"]},
    "role_policy": {"enum": ["context-marker-v1", "tc-generator-v1", "canonical-reviewer-v1", "tc-to-autotest-v1", "autotest-static-reviewer-v1"]},
    "model_id": {
      "anyOf": [
        {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,255}$"},
        {"type": "null"}
      ]
    },
    "invocation_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,255}$"},
    "input_digests": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
    },
    "skill_pack_digest": {"description": "FaT-CR: skill_pack_digest of the package the answer is made with (context-marker).", "type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "reuse": {
      "description": "FaT-CR: the earlier run whose answer for the same stage and inputs this request reuses.",
      "type": "object", "additionalProperties": false, "required": ["run_id", "attempt_id", "request_digest", "response_digest"],
      "properties": {
        "run_id": {"type": "string", "pattern": "^[0-9a-f]{32}$"},
        "attempt_id": {"type": "string", "pattern": "^[0-9a-f]{32}$"},
        "request_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "response_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      }
    },
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  }
}
