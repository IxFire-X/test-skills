{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schemas/model-request.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "attempt_id",
    "stage_instance_id",
    "stage",
    "role",
    "role_policy",
    "model_id",
    "invocation_id",
    "input_digests",
    "digest"
  ],
  "properties": {
    "schema_version": {"const": "2.0.0"},
    "run_id": {"type": "string", "pattern": "^[0-9a-f]{32}$"},
    "attempt_id": {"type": "string", "pattern": "^[0-9a-f]{32}$"},
    "stage_instance_id": {"type": "string", "pattern": "^(?:context-marker:baseline|tc-generator:BATCH-[a-z0-9-]+|tc-reviewer:canonical:part-[0-9]{6}(?:-try[23])?|tc-to-autotest:r[12]|autotest-reviewer:r[12]:part-[0-9]{6}(?:-try[23])?)$"},
    "stage": {"enum": ["context-marker", "tc-generator", "tc-reviewer", "tc-to-autotest", "autotest-reviewer"]},
    "role": {"enum": ["generator", "canonical-reviewer", "automation-generator", "automation-reviewer"]},
    "role_policy": {"enum": ["context-marker-v1", "tc-generator-v1", "canonical-reviewer-v2", "tc-to-autotest-v1", "autotest-static-reviewer-v2"]},
    "model_id": {
      "anyOf": [
        {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,255}$"},
        {"type": "null"}
      ]
    },
    "invocation_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,255}$"},
    "input_digests": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
    },
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  }
}
