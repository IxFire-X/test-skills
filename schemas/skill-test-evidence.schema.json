{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schemas/skill-test-evidence.schema.json",
  "title": "Immutable portable skill campaign evidence",
  "oneOf": [
    {
      "type": "object",
      "required": ["artifact_type", "skill_id", "canonical_prompt", "pressure_prompt", "raw_input_allowlist", "rubric_ids", "repetitions", "fork_turns", "output_paths", "prompt_sha256"],
      "additionalProperties": false,
      "properties": {
        "artifact_type": {"const": "scenario"},
        "skill_id": {"$ref": "#/$defs/skill_id"},
        "canonical_prompt": {"type": "string", "minLength": 1},
        "pressure_prompt": {"type": "string", "minLength": 1},
        "raw_input_allowlist": {"$ref": "#/$defs/allowlist"},
        "rubric_ids": {"$ref": "#/$defs/rubric_ids"},
        "repetitions": {"const": 5},
        "fork_turns": {"const": "none"},
        "output_paths": {"type": "array", "minItems": 15, "maxItems": 15, "uniqueItems": true, "items": {"type": "string", "pattern": "^artifacts/outputs/(01-red-control|02-green-initial|04-green-final)/rep-0[1-5]$"}},
        "prompt_sha256": {"$ref": "#/$defs/prompt_hashes"}
      }
    },
    {
      "type": "object",
      "required": ["artifact_type", "skill_id", "phase", "status", "rubric_ids", "results", "evidence_files", "all_passed", "no_gap", "no_edit_reason"],
      "additionalProperties": false,
      "properties": {
        "artifact_type": {"const": "scorecard"},
        "skill_id": {"$ref": "#/$defs/skill_id"},
        "phase": {"enum": ["red", "green-initial", "green-final"]},
        "status": {"enum": ["pending", "complete"]},
        "rubric_ids": {"$ref": "#/$defs/rubric_ids"},
        "results": {"type": "object", "propertyNames": {"pattern": "^rep-0[1-5]$"}, "additionalProperties": {"type": "object", "additionalProperties": {"type": "boolean"}}},
        "evidence_files": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^(01-red-control|02-green-initial|04-green-final)/rep-0[1-5]\\.md$"}},
        "all_passed": {"type": "boolean"},
        "no_gap": {"type": "boolean"},
        "no_edit_reason": {"type": ["string", "null"]}
      },
      "allOf": [
        {"if": {"properties": {"status": {"const": "pending"}}, "required": ["status"]}, "then": {"properties": {"results": {"maxProperties": 0}, "evidence_files": {"maxItems": 0}, "all_passed": {"const": false}, "no_gap": {"const": false}, "no_edit_reason": {"type": "null"}}}},
        {"if": {"properties": {"status": {"const": "complete"}}, "required": ["status"]}, "then": {"properties": {"results": {"minProperties": 5, "maxProperties": 5}, "evidence_files": {"minItems": 5}, "no_edit_reason": {"type": ["string", "null"]}}}}
      ]
    },
    {
      "type": "object",
      "required": ["artifact_type", "skill_id", "status", "evaluator", "host", "model", "fork_turns", "timestamps", "prompt_sha256", "raw_input_allowlist", "output_digests", "command_exit_codes"],
      "additionalProperties": false,
      "properties": {
        "artifact_type": {"const": "run-metadata"},
        "skill_id": {"$ref": "#/$defs/skill_id"},
        "status": {"enum": ["pending", "complete"]},
        "evaluator": {"type": ["string", "null"]},
        "host": {"type": ["string", "null"]},
        "model": {"type": ["string", "null"]},
        "fork_turns": {"const": "none"},
        "timestamps": {"type": "array", "items": {"type": "string", "format": "date-time"}},
        "prompt_sha256": {"$ref": "#/$defs/prompt_hashes"},
        "raw_input_allowlist": {"$ref": "#/$defs/allowlist"},
        "output_digests": {"type": "object", "additionalProperties": {"type": "string", "pattern": "^[0-9a-f]{64}$"}},
        "command_exit_codes": {"type": "object", "additionalProperties": {"type": "integer"}}
      },
      "allOf": [
        {"if": {"properties": {"status": {"const": "pending"}}, "required": ["status"]}, "then": {"properties": {"evaluator": {"type": "null"}, "host": {"type": "null"}, "model": {"type": "null"}, "timestamps": {"maxItems": 0}, "output_digests": {"maxProperties": 0}, "command_exit_codes": {"maxProperties": 0}}}},
        {"if": {"properties": {"status": {"const": "complete"}}, "required": ["status"]}, "then": {"properties": {"evaluator": {"type": "string", "minLength": 1}, "host": {"type": "string", "minLength": 1}, "model": {"type": "string", "minLength": 1}, "timestamps": {"minItems": 1}, "output_digests": {"minProperties": 1}, "command_exit_codes": {"minProperties": 1}}}}
      ]
    }
  ],
  "$defs": {
    "skill_id": {"enum": ["context-marker", "tc-generator", "tc-reviewer", "tc-to-autotest", "autotest-reviewer", "orchestrate"]},
    "allowlist": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^artifacts/inputs/[A-Za-z0-9._/-]+$"}},
    "rubric_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"}},
    "prompt_hashes": {"type": "object", "required": ["canonical", "pressure"], "additionalProperties": false, "properties": {"canonical": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "pressure": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}}
  }
}
