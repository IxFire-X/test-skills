{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "skillsrc initialization receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["status", "skillsrc_path", "written", "module_ids", "questions", "changes", "warnings", "errors", "discovery_fingerprint"],
  "properties": {
    "status": {"enum": ["preview", "created", "updated", "unchanged", "needs_input", "conflict", "error"]},
    "skillsrc_path": {"const": ".skillsrc"},
    "written": {"type": "boolean"},
    "module_ids": {"type": "array", "items": {"type": "string"}},
    "questions": {"type": "array", "items": {"type": "object"}},
    "changes": {"type": "array", "items": {"type": "object"}},
    "warnings": {"type": "array", "items": {"type": "string"}},
    "errors": {"type": "array", "items": {"type": "string"}},
    "discovery_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "allOf": [
    {"if": {"properties": {"status": {"enum": ["created", "updated"]}}}, "then": {"properties": {"written": {"const": true}, "changes": {"minItems": 1}}}},
    {"if": {"properties": {"status": {"const": "unchanged"}}}, "then": {"properties": {"written": {"const": false}, "changes": {"maxItems": 0}}}},
    {"if": {"properties": {"status": {"enum": ["preview", "needs_input", "conflict", "error"]}}}, "then": {"properties": {"written": {"const": false}}}},
    {"if": {"properties": {"status": {"enum": ["needs_input", "conflict"]}}}, "then": {"properties": {"questions": {"minItems": 1}}}},
    {"if": {"properties": {"status": {"const": "error"}}}, "then": {"properties": {"errors": {"minItems": 1}}}}
  ]
}
