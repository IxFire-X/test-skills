{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schemas/driver-summary.schema.json",
  "description": "The `result` of a driver `done` payload for a terminal attempt (pipeline_driver._result_summary).",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "status", "run_id", "attempt_id", "policy_profile", "completion", "verification", "coverage", "accepted", "reason_code", "exit_code",
               "review_independence", "warnings", "effective_document_digest", "paths"],
  "properties": {
    "schema_version": {"enum": ["1.0.0", "1.1.0", "1.2.0", "1.3.0"]},
    "status": {"const": "terminal"},
    "run_id": {"type": "string", "pattern": "^[0-9a-f]{32}$"},
    "attempt_id": {"type": "string", "pattern": "^[0-9a-f]{32}$"},
    "policy_profile": {"enum": ["cases-only-v1", "local-pilot-v1"]},
    "completion": {"enum": ["COMPLETE", "PARTIAL", "FATAL"]},
    "verification": {"enum": ["PASS", "FAIL", "UNKNOWN", "NOT_RUNNABLE", "NOT_APPLICABLE"]},
    "coverage": {"enum": ["FULL", "MIXED", "MANUAL_ONLY", null]},
    "accepted": {"type": "boolean"},
    "reason_code": {"type": ["string", "null"], "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"},
    "exit_code": {"enum": [0, 1, 2]},
    "review_independence": {"enum": ["ISOLATED", "SELF", null]},
    "warnings": {
      "type": "array",
      "items": {"oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["code", "attempt_id", "review_key", "review_input_bytes", "context_bytes", "message"],
          "properties": {
            "code": {"const": "SELF_REVIEW_CONTEXT_OVERFLOW"},
            "attempt_id": {"type": "string", "pattern": "^[0-9a-f]{32}$"},
            "review_key": {"enum": ["canonical", "r1", "r2"]},
            "review_input_bytes": {"type": "integer", "minimum": 1},
            "context_bytes": {"type": "integer", "minimum": 1},
            "message": {"type": "string", "minLength": 1}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["code", "attempt_id", "message"],
          "description": "D1: one priority level holds more than 70 % of the cases (summary 1.3.0).",
          "properties": {
            "code": {"const": "PRIORITY_DEGENERATE"},
            "attempt_id": {"type": "string", "pattern": "^[0-9a-f]{32}$"},
            "message": {"type": "string", "minLength": 1}
          }
        }
      ]}
    },
    "design_coverage": {
      "type": "object",
      "additionalProperties": false,
      "description": "D1 (summary 1.3.0): design elements the effective cases cover, the uncovered ones with reasons, and the spread of the code-assigned priorities.",
      "required": ["partitions", "boundaries", "rules", "negative_partitions", "uncovered", "priorities"],
      "properties": {
        "partitions": {"$ref": "#/$defs/design_share"},
        "boundaries": {"$ref": "#/$defs/design_share"},
        "rules": {"$ref": "#/$defs/design_share"},
        "negative_partitions": {"$ref": "#/$defs/design_share"},
        "combinations": {"$ref": "#/$defs/design_share"},
        "uncovered": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["ref", "reason"],
                                                 "properties": {"ref": {"type": "string", "pattern": "^(?:EQ|BV|DR|CB)-[0-9]{3,}$"}, "reason": {"type": "string", "minLength": 1}}}},
        "priorities": {"type": "object", "additionalProperties": false, "required": ["CRITICAL", "HIGH", "MEDIUM", "LOW"],
                       "properties": {"CRITICAL": {"type": "integer", "minimum": 0}, "HIGH": {"type": "integer", "minimum": 0},
                                      "MEDIUM": {"type": "integer", "minimum": 0}, "LOW": {"type": "integer", "minimum": 0}}}
      }
    },
    "effective_document_digest": {"type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}$"},
    "paths": {
      "type": "object",
      "additionalProperties": false,
      "properties": {"candidate_bundle": {"type": "string"}, "run_root": {"type": "string"}, "driver_dir": {"type": "string"},
                     "test_strength_json": {"type": "string"}, "test_strength_markdown": {"type": "string"},
                     "analyst_report_json": {"type": "string"}, "analyst_report_markdown": {"type": "string"},
                     "suite_dir": {"type": "string"}, "suite_manifest": {"type": "string"},
                     "quarantine_markdown": {"type": "string"}}
    },
    "exec": {"type": "object"},
    "build_failure": {
      "description": "NOT_RUNNABLE/BUILD_FAILED_BEFORE_TESTS: the build step that failed and the tail of runner-output.txt.",
      "type": "object", "additionalProperties": false, "required": ["message", "output_tail"],
      "properties": {"message": {"type": "string", "minLength": 1},
                     "output_tail": {"type": "array", "maxItems": 20, "items": {"type": "string", "maxLength": 300}}}
    },
    "test_strength": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "reason_code", "killed", "survived", "no_coverage", "timed_out", "memory_error", "score", "survivor_groups", "duration_seconds"],
      "properties": {
        "status": {"enum": ["MEASURED", "NOT_RUNNABLE", "NOT_APPLICABLE"]},
        "reason_code": {"type": ["string", "null"]},
        "killed": {"type": "integer", "minimum": 0}, "survived": {"type": "integer", "minimum": 0}, "no_coverage": {"type": "integer", "minimum": 0},
        "timed_out": {"type": "integer", "minimum": 0}, "memory_error": {"type": "integer", "minimum": 0},
        "score": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "survivor_groups": {"type": "integer", "minimum": 0},
        "duration_seconds": {"type": "number", "minimum": 0}
      }
    },
    "isolation_evidence": {"enum": ["DRIVER_PROCESS", "HOST_DECLARED", "NONE", null]},
    "strength_triage": {"type": "object"},
    "analyst_questions": {"type": "integer", "minimum": 0},
    "suite": {
      "description": "Opt-in --suite (wave 3): whether the living suite was written after the terminal result.",
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "reason_code", "message", "cases", "files"],
      "properties": {
        "status": {"enum": ["WRITTEN", "NOT_WRITTEN"]},
        "reason_code": {"type": ["string", "null"], "pattern": "^[A-Z][A-Z0-9_]{0,63}$"},
        "message": {"type": ["string", "null"]},
        "cases": {"type": "integer", "minimum": 0}, "files": {"type": "integer", "minimum": 0},
        "quarantined": {"type": "integer", "minimum": 1}
      }
    }
  },
  "allOf": [
    {"if": {"properties": {"schema_version": {"const": "1.0.0"}}, "required": ["schema_version"]},
     "then": {"not": {"anyOf": [{"required": ["test_strength"]}, {"required": ["isolation_evidence"]}, {"required": ["strength_triage"]}, {"required": ["analyst_questions"]}, {"required": ["suite"]}]}}},
    {"if": {"properties": {"schema_version": {"const": "1.1.0"}}, "required": ["schema_version"]},
     "then": {"not": {"required": ["suite"]}}},
    {"if": {"properties": {"schema_version": {"enum": ["1.0.0", "1.1.0", "1.2.0"]}}, "required": ["schema_version"]},
     "then": {"not": {"required": ["design_coverage"]}}}
  ],
  "$defs": {
    "design_share": {"type": "object", "additionalProperties": false, "required": ["total", "covered", "uncovered", "ratio"],
                     "properties": {"total": {"type": "integer", "minimum": 0}, "covered": {"type": "integer", "minimum": 0},
                                    "uncovered": {"type": "integer", "minimum": 0}, "ratio": {"type": ["number", "null"], "minimum": 0, "maximum": 1}}}
  }
}
