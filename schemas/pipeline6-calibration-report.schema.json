{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schemas/pipeline6-calibration-report.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "artifact", "suite", "suite_sha256", "review_mode", "target", "attempt_root_sha256", "controls", "terminal_receipt_sha256", "baseline_receipt_sha256", "mismatch_count", "overall"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "artifact": {"const": "pipeline6-calibration-report"},
    "suite": {"const": "change-scoped-semantic-evidence"},
    "suite_sha256": {"$ref": "#/$defs/digest"},
    "review_mode": {"const": "SEQUENTIAL"},
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commit", "tree", "clean"],
      "properties": {"commit": {"$ref": "#/$defs/git"}, "tree": {"$ref": "#/$defs/git"}, "clean": {"const": true}}
    },
    "attempt_root_sha256": {"$ref": "#/$defs/digest"},
    "controls": {"type": "array", "minItems": 24, "maxItems": 24, "uniqueItems": true, "items": {"$ref": "#/$defs/control"}},
    "terminal_receipt_sha256": {"$ref": "#/$defs/digest"},
    "baseline_receipt_sha256": {"$ref": "#/$defs/digest"},
    "mismatch_count": {"type": "integer", "minimum": 0, "maximum": 168},
    "overall": {"enum": ["PASS", "FAIL"]}
  },
  "allOf": [
    {"if": {"properties": {"overall": {"const": "PASS"}}, "required": ["overall"]}, "then": {"properties": {"mismatch_count": {"const": 0}, "controls": {"items": {"allOf": [{"$ref": "#/$defs/control"}, {"properties": {"mismatch_count": {"const": 0}, "status": {"const": "PASS"}}}]}}}}},
    {"if": {"properties": {"overall": {"const": "FAIL"}}, "required": ["overall"]}, "then": {"properties": {"mismatch_count": {"minimum": 1}, "controls": {"contains": {"properties": {"status": {"const": "FAIL"}}, "required": ["status"]}, "minContains": 1}}}}
  ],
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "git": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "phase_result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["phase", "expected_verdict", "actual_verdict", "matches_expected", "artifact_sha256s"],
      "properties": {
        "phase": {"type": "string"},
        "expected_verdict": {"const": "PASS"},
        "actual_verdict": {"enum": ["PASS", "FAIL"]},
        "matches_expected": {"type": "boolean"},
        "artifact_sha256s": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/digest"}}
      },
      "anyOf": [
        {"properties": {"expected_verdict": {"const": "PASS"}, "actual_verdict": {"const": "PASS"}, "matches_expected": {"const": true}}},
        {"properties": {"expected_verdict": {"const": "PASS"}, "actual_verdict": {"const": "FAIL"}, "matches_expected": {"const": false}}}
      ]
    },
    "phases": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "prefixItems": [
        {"allOf": [{"$ref": "#/$defs/phase_result"}, {"properties": {"phase": {"const": "scope_selection"}}}]},
        {"allOf": [{"$ref": "#/$defs/phase_result"}, {"properties": {"phase": {"const": "scope_false_inclusion"}}}]},
        {"allOf": [{"$ref": "#/$defs/phase_result"}, {"properties": {"phase": {"const": "scope_omission"}}}]},
        {"allOf": [{"$ref": "#/$defs/phase_result"}, {"properties": {"phase": {"const": "candidate_extraction"}}}]},
        {"allOf": [{"$ref": "#/$defs/phase_result"}, {"properties": {"phase": {"const": "batch_false_claim"}}}]},
        {"allOf": [{"$ref": "#/$defs/phase_result"}, {"properties": {"phase": {"const": "batch_omission"}}}]},
        {"allOf": [{"$ref": "#/$defs/phase_result"}, {"properties": {"phase": {"const": "promotion"}}}]}
      ],
      "items": false
    },
    "control": {
      "type": "object",
      "additionalProperties": false,
      "required": ["control_id", "phases", "mismatch_count", "status"],
      "properties": {
        "control_id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*\\.(supported|deceptive_or_no_fact)$"},
        "phases": {"$ref": "#/$defs/phases"},
        "mismatch_count": {"type": "integer", "minimum": 0, "maximum": 7},
        "status": {"enum": ["PASS", "FAIL"]}
      },
      "allOf": [
        {"if": {"properties": {"status": {"const": "PASS"}}, "required": ["status"]}, "then": {"properties": {"mismatch_count": {"const": 0}, "phases": {"items": {"properties": {"matches_expected": {"const": true}}}}}}},
        {"if": {"properties": {"status": {"const": "FAIL"}}, "required": ["status"]}, "then": {"properties": {"mismatch_count": {"minimum": 1}, "phases": {"contains": {"properties": {"matches_expected": {"const": false}}, "required": ["matches_expected"]}, "minContains": 1}}}}
      ]
    }
  }
}
