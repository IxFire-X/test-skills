{
  "$schema":"https://json-schema.org/draft/2020-12/schema", "$id":"schemas/behavior-context-plan.schema.json", "type":"object", "additionalProperties":false,
  "required":["schema_version","selected_module","authorized_behavior_sources_sha256","batches"],
  "properties":{"schema_version":{"const":"1.0.0"},"selected_module":{"type":"string","minLength":1},"authorized_behavior_sources_sha256":{"$ref":"#/$defs/digest"},"batches":{"type":"array","items":{"$ref":"#/$defs/batch"}}},
  "$defs":{"digest":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},"range":{"type":"object","additionalProperties":false,"required":["start","end"],"properties":{"start":{"type":"integer","minimum":0},"end":{"type":"integer","minimum":0}}},"item":{"type":"object","additionalProperties":false,"required":["item_id","source_id","domain_key","accounted_range","read_range"],"properties":{"item_id":{"type":"string","pattern":"^ITEM-[0-9]{6}$"},"source_id":{"type":"string","minLength":1},"domain_key":{"type":"string","minLength":1},"accounted_range":{"$ref":"#/$defs/range"},"read_range":{"$ref":"#/$defs/range"}}},"batch":{"type":"object","additionalProperties":false,"required":["batch_id","items"],"properties":{"batch_id":{"type":"string","pattern":"^BATCH-[0-9]{6}$"},"items":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/item"}}}}}
}
