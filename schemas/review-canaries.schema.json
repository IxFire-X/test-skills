{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schemas/review-canaries.schema.json",
  "description": "P7: the map of the control errors (canaries) that code put into the reviewer's view of a candidate. A signal of the quality of the review, not a protection: the map lies in <run>/review-views/ next to the view.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "candidate_digest", "canaries"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "candidate_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "canaries": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["canary_id", "class", "case_id", "step_id", "expectation_id", "assertion_id", "field", "original", "mutated", "markers"],
        "properties": {
          "canary_id": {"type": "string", "pattern": "^CAN-[1-3]$"},
          "class": {"enum": ["assertion_removed", "boundary", "status", "state_check_removed"]},
          "case_id": {"type": "string", "pattern": "^TC-[A-Za-z0-9_.:-]+$"},
          "step_id": {"type": "string", "pattern": "^STEP-[A-Za-z0-9_.:-]+$"},
          "expectation_id": {"type": ["string", "null"], "pattern": "^EXP-[A-Za-z0-9_.:-]+$"},
          "assertion_id": {"type": ["string", "null"], "minLength": 1},
          "field": {"enum": ["expectation", "test_data", "assertions"]},
          "original": {"type": "string"},
          "mutated": {"type": "string"},
          "markers": {"type": "array", "maxItems": 4, "items": {"type": "string", "minLength": 1}}
        }
      }
    }
  }
}
