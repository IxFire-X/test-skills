{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schemas/run-tests-output.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "stage", "source", "automation_sha256", "autotest_review_sha256", "verdict", "target", "environment", "execution", "stats", "failed_methods", "root_cause", "raw_output_excerpt", "ran_at", "exit_code", "run_id", "execution_evidence", "process_evidence", "evidence_authoritative", "diagnostics"],
  "properties": {
    "schema_version": {"const": "5.0.0"},
    "stage": {"const": "run-tests"},
    "source": {"$ref": "#/$defs/source"},
    "automation_sha256": {"$ref": "#/$defs/digest"},
    "autotest_review_sha256": {"$ref": "#/$defs/digest"},
    "verdict": {"enum": ["PASS", "FAIL", "UNKNOWN", "NOT_RUNNABLE"]},
    "target": {"$ref": "#/$defs/target"},
    "environment": {"$ref": "#/$defs/environment"},
    "execution": {"$ref": "#/$defs/execution"},
    "stats": {"type": ["object", "null"], "additionalProperties": false, "required": ["total", "passed", "failed", "errors", "skipped", "duration_sec"], "properties": {"total": {"type": ["integer", "null"], "minimum": 0}, "passed": {"type": "integer", "minimum": 0}, "failed": {"type": "integer", "minimum": 0}, "errors": {"type": "integer", "minimum": 0}, "skipped": {"type": "integer", "minimum": 0}, "duration_sec": {"type": ["number", "null"], "minimum": 0}}},
    "failed_methods": {"type": ["array", "null"], "items": {"type": "object", "additionalProperties": false, "required": ["nodeid", "kind", "message"], "properties": {"nodeid": {"type": "string"}, "kind": {"enum": ["assertion_failed", "error", "collection_error", "timeout", "unknown"]}, "message": {"type": "string"}}}},
    "root_cause": {"type": ["array", "null"], "items": {"type": "string"}},
    "raw_output_excerpt": {"type": "null"},
    "ran_at": {"type": "string", "format": "date-time"},
    "exit_code": {"type": ["integer", "null"]},
    "run_id": {"type": ["string", "null"], "pattern": "^RUN-[A-Za-z0-9_.:-]+$"},
    "execution_evidence": {"type": "array", "items": {"$ref": "#/$defs/evidence"}},
    "process_evidence": {"type": "array", "maxItems": 2, "items": {"$ref": "#/$defs/process_evidence"}, "allOf": [{"contains": {"properties": {"kind": {"const": "SOURCE_CHANGED"}}, "required": ["kind"]}, "minContains": 0, "maxContains": 1}, {"contains": {"properties": {"kind": {"not": {"const": "SOURCE_CHANGED"}}}, "required": ["kind"]}, "minContains": 0, "maxContains": 1}]},
    "evidence_authoritative": {"type": "boolean"},
    "diagnostics": {"type": "array", "items": {"$ref": "#/$defs/diagnostic"}}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "source": {"type": "object", "additionalProperties": false, "required": ["document_id", "revision", "source_digest", "effective_bundle_receipt_digest"], "properties": {"document_id": {"type": "string", "pattern": "^TCDOC-[A-Za-z0-9_.:-]+$"}, "revision": {"type": "integer", "minimum": 1}, "source_digest": {"$ref": "#/$defs/digest"}, "effective_bundle_receipt_digest": {"$ref": "#/$defs/digest"}}},
    "target": {"type": "object", "additionalProperties": false, "required": ["language", "framework", "runner", "command"], "properties": {"language": {"enum": ["python", "java", "unknown"]}, "framework": {"enum": ["pytest", "junit5", "unknown"]}, "runner": {"enum": ["pytest", "maven", "gradle", "not_applicable"]}, "command": {"type": ["string", "null"]}}},
    "environment": {"type": "object", "additionalProperties": false, "required": ["status", "interpreter", "interpreter_path", "working_dir", "missing", "safe_key_labels"], "properties": {"status": {"enum": ["ready", "missing", "partial"]}, "interpreter": {"type": ["string", "null"]}, "interpreter_path": {"type": ["string", "null"]}, "working_dir": {"type": "string"}, "missing": {"type": ["array", "null"], "items": {"type": "string"}}, "safe_key_labels": {"type": "array", "uniqueItems": true, "items": {"enum": ["PROJECT_NATIVE_ENV"]}}}},
    "execution": {"type": "object", "additionalProperties": false, "required": ["adapter_id", "executable_path", "cwd", "run_id", "attempt_id", "baseline_digest", "generated_delta_digest", "build_profile", "typed_parameters", "argv", "selectors", "timeout_seconds", "report_paths", "request_digest", "report_evidence", "artifact_evidence"], "properties": {"adapter_id": {"type": ["string", "null"], "enum": ["pytest:selected-symbols-v1", "maven-wrapper:selected-symbols-v1", "maven:selected-symbols-v1", "gradle-wrapper:selected-symbols-v1", null]}, "executable_path": {"type": ["string", "null"]}, "cwd": {"type": ["string", "null"]}, "run_id": {"type": ["string", "null"]}, "attempt_id": {"type": ["string", "null"]}, "baseline_digest": {"type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}$"}, "generated_delta_digest": {"type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}$"}, "build_profile": {"type": ["string", "null"]}, "typed_parameters": {"type": "object", "additionalProperties": {"type": ["string", "number", "boolean", "null"]}}, "argv": {"type": "array", "items": {"type": "string"}}, "selectors": {"type": "array", "items": {"type": "string"}}, "timeout_seconds": {"type": ["integer", "null"], "minimum": 1}, "report_paths": {"type": "array", "items": {"type": "string"}}, "request_digest": {"type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}$"}, "report_evidence": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["path", "digest"], "properties": {"path": {"type": "string", "minLength": 1}, "digest": {"$ref": "#/$defs/digest"}}}}, "artifact_evidence": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/artifact_evidence"}}, "environment_inputs": {"type": "array", "uniqueItems": true, "items": {"type": "object", "additionalProperties": false, "required": ["name", "value_digest"], "properties": {"name": {"enum": ["PYTEST_ADDOPTS", "PYTEST_PLUGINS", "MAVEN_OPTS", "MAVEN_ARGS", "JAVA_TOOL_OPTIONS", "_JAVA_OPTIONS", "GRADLE_OPTS", "JAVA_HOME"]}, "value_digest": {"$ref": "#/$defs/digest"}}}}}},
    "artifact_evidence": {"oneOf": [{"type": "object", "additionalProperties": false, "required": ["kind", "source_path", "source_digest", "normalization", "path", "digest"], "properties": {"kind": {"const": "native_report"}, "source_path": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*\\\\)[^\\r\\n]+$"}, "source_digest": {"$ref": "#/$defs/digest"}, "normalization": {"const": "junit-semantic-v1"}, "path": {"type": "string", "pattern": "^artifacts/[0-9a-f]{32}/reports/[^\\r\\n]+$"}, "digest": {"$ref": "#/$defs/digest"}}}, {"type": "object", "additionalProperties": false, "required": ["kind", "source_path", "path", "digest"], "properties": {"kind": {"const": "generated_test"}, "source_path": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*\\\\)[^\\r\\n]+$"}, "path": {"type": "string", "pattern": "^artifacts/[0-9a-f]{32}/generated/[^\\r\\n]+$"}, "digest": {"$ref": "#/$defs/digest"}}}, {"type": "object", "additionalProperties": false, "required": ["kind", "path", "digest"], "properties": {"kind": {"const": "runner_output"}, "path": {"type": "string", "pattern": "^artifacts/[0-9a-f]{32}/runner-output\\.txt$"}, "digest": {"$ref": "#/$defs/digest"}}}]},
    "diagnostic": {"type": "object", "additionalProperties": false, "required": ["path", "code", "message"], "properties": {"path": {"type": "string"}, "code": {"type": "string", "minLength": 1}, "message": {"type": "string", "minLength": 1}}},
    "evidence": {"type": "object", "additionalProperties": false, "required": ["run_id", "source_digest", "file_id", "symbol_id", "file_digest", "status"], "properties": {"run_id": {"type": "string", "pattern": "^RUN-[A-Za-z0-9_.:-]+$"}, "source_digest": {"$ref": "#/$defs/digest"}, "file_id": {"type": "string", "pattern": "^FILE-[A-Za-z0-9_.:-]+$"}, "symbol_id": {"type": "string", "pattern": "^SYMBOL-[A-Za-z0-9_.:-]+$"}, "file_digest": {"$ref": "#/$defs/digest"}, "status": {"enum": ["PASSED", "FAILED", "ERROR", "SKIPPED"]}}},
    "process_evidence": {"type": "object", "additionalProperties": false, "required": ["run_id", "source_digest", "kind", "error_class", "exit_cause", "command_profile", "duration_sec", "stdout_tail", "stderr_tail"], "properties": {"run_id": {"type": "string", "pattern": "^RUN-[A-Za-z0-9_.:-]+$"}, "source_digest": {"$ref": "#/$defs/digest"}, "kind": {"enum": ["TIMEOUT", "OS_ERROR", "COLLECTION_ERROR", "EXECUTION_ERROR", "JUNIT_MISSING", "JUNIT_INVALID", "SOURCE_CHANGED", "BASELINE_DRIFT", "NO_TESTS_COLLECTED", "GENERATED_TEST_INVALID", "LAUNCH_FAILED", "TESTS_DESELECTED", "NONZERO_EXIT_GREEN_REPORT", "ARTIFACT_PERSISTENCE_FAILED"]}, "error_class": {"enum": ["TimeoutExpired", "OSError", "CollectionError", "ExecutionError", "JUnitMissing", "ParseError", "SourceChanged", "BaselineDrift", "NoTestsCollected", "GeneratedTestInvalid", "LaunchFailed", "TestsDeselected", "NonzeroExitGreenReport", "ArtifactPersistenceFailed"]}, "exit_cause": {"enum": ["TIMEOUT", "OS_ERROR", "NONZERO_EXIT", "ZERO_EXIT"]}, "command_profile": {"enum": ["pytest:selected-symbols-v1", "maven-wrapper:selected-symbols-v1", "maven:selected-symbols-v1", "gradle-wrapper:selected-symbols-v1"]}, "duration_sec": {"type": "number", "minimum": 0}, "stdout_tail": {"type": "string", "maxLength": 2000}, "stderr_tail": {"type": "string", "maxLength": 2000}, "affected_file_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^FILE-[A-Za-z0-9_.:-]+$"}}, "process_scope_stopped": {"const": true}, "stop_proof": {"enum": ["WINDOWS_JOB_OBJECT", "WINDOWS_TASKKILL_TREE", "POSIX_PROCESS_GROUP", "WINDOWS_JOB_TERMINATED"]}}, "allOf": [{"if": {"properties": {"kind": {"const": "SOURCE_CHANGED"}}, "required": ["kind"]}, "then": {"required": ["affected_file_ids"]}}, {"if": {"properties": {"kind": {"not": {"const": "SOURCE_CHANGED"}}}, "required": ["kind"]}, "then": {"not": {"required": ["affected_file_ids"]}}}, {"if": {"required": ["process_scope_stopped"]}, "then": {"properties": {"kind": {"const": "TIMEOUT"}}, "required": ["stop_proof"]}}, {"if": {"required": ["stop_proof"]}, "then": {"properties": {"kind": {"const": "TIMEOUT"}}, "required": ["process_scope_stopped"]}}]}
  },
  "allOf": [
    {"if": {"properties": {"verdict": {"const": "PASS"}}, "required": ["verdict"]}, "then": {"properties": {"run_id": {"type": "string"}, "stats": {"type": "object"}, "exit_code": {"const": 0}, "execution_evidence": {"minItems": 1, "not": {"contains": {"properties": {"status": {"const": "SKIPPED"}}, "required": ["status"]}}}, "process_evidence": {"maxItems": 0}, "evidence_authoritative": {"const": true}, "execution": {"properties": {"report_evidence": {"minItems": 1}, "artifact_evidence": {"minItems": 2, "allOf": [{"contains": {"properties": {"kind": {"const": "native_report"}}, "required": ["kind"]}, "minContains": 1}, {"contains": {"properties": {"kind": {"const": "generated_test"}}, "required": ["kind"]}, "minContains": 1}]}}, "required": ["report_evidence", "artifact_evidence"]}}}},
    {"if": {"properties": {"verdict": {"const": "FAIL"}}, "required": ["verdict"]}, "then": {"properties": {"run_id": {"type": "string"}, "stats": {"type": "object"}, "exit_code": {"type": "integer"}, "execution": {"properties": {"report_evidence": {"minItems": 1}, "artifact_evidence": {"minItems": 2, "allOf": [{"contains": {"properties": {"kind": {"const": "native_report"}}, "required": ["kind"]}, "minContains": 1}, {"contains": {"properties": {"kind": {"const": "generated_test"}}, "required": ["kind"]}, "minContains": 1}]}}, "required": ["report_evidence", "artifact_evidence"]}}, "oneOf": [{"properties": {"execution_evidence": {"minItems": 1, "contains": {"properties": {"status": {"enum": ["FAILED", "ERROR"]}}, "required": ["status"]}}, "evidence_authoritative": {"const": true}}}, {"properties": {"execution_evidence": {"maxItems": 0}, "process_evidence": {"minItems": 1, "contains": {"properties": {"kind": {"const": "NO_TESTS_COLLECTED"}}, "required": ["kind"]}}, "stats": {"type": "object", "additionalProperties": false, "required": ["total", "passed", "failed", "errors", "skipped", "duration_sec"], "properties": {"total": {"const": 0}, "passed": {"type": "integer", "minimum": 0}, "failed": {"type": "integer", "minimum": 0}, "errors": {"type": "integer", "minimum": 0}, "skipped": {"type": "integer", "minimum": 0}, "duration_sec": {"type": ["number", "null"], "minimum": 0}}}, "evidence_authoritative": {"const": true}}}]}},
    {"if": {"properties": {"verdict": {"const": "UNKNOWN"}}, "required": ["verdict"]}, "then": {"properties": {"run_id": {"type": "string"}, "stats": {"type": "object"}, "exit_code": {"type": "integer"}, "evidence_authoritative": {"const": false}}}},
    {"if": {"properties": {"verdict": {"const": "NOT_RUNNABLE"}, "run_id": {"type": "null"}}, "required": ["verdict", "run_id"]}, "then": {"properties": {"stats": {"type": "null"}, "exit_code": {"type": "null"}, "execution_evidence": {"maxItems": 0}, "process_evidence": {"maxItems": 0}, "evidence_authoritative": {"const": false}, "diagnostics": {"minItems": 1}}}},
    {"if": {"properties": {"verdict": {"const": "NOT_RUNNABLE"}, "run_id": {"type": "string"}}, "required": ["verdict", "run_id"]}, "then": {"properties": {"stats": {"type": "object"}, "exit_code": {"type": "integer"}}}}
  ]
}
