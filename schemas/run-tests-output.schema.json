{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schemas/run-tests-output.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "stage", "source", "verdict", "target", "environment", "stats", "failed_methods", "root_cause", "raw_output_excerpt", "ran_at", "exit_code", "run_id", "execution_evidence", "evidence_authoritative", "diagnostics"],
  "properties": {
    "schema_version": {"const": "3.0.0"},
    "stage": {"const": "run-tests"},
    "source": {"$ref": "#/$defs/source"},
    "verdict": {"enum": ["PASS", "FAIL", "NOT_RUNNABLE"]},
    "target": {"$ref": "#/$defs/target"},
    "environment": {"$ref": "#/$defs/environment"},
    "stats": {"type": ["object", "null"], "additionalProperties": false, "required": ["total", "passed", "failed", "errors", "skipped", "duration_sec"], "properties": {"total": {"type": ["integer", "null"], "minimum": 0}, "passed": {"type": "integer", "minimum": 0}, "failed": {"type": "integer", "minimum": 0}, "errors": {"type": "integer", "minimum": 0}, "skipped": {"type": "integer", "minimum": 0}, "duration_sec": {"type": ["number", "null"], "minimum": 0}}},
    "failed_methods": {"type": ["array", "null"], "items": {"type": "object", "additionalProperties": false, "required": ["nodeid", "kind", "message"], "properties": {"nodeid": {"type": "string"}, "kind": {"enum": ["assertion_failed", "error", "collection_error", "timeout", "unknown"]}, "message": {"type": "string"}}}},
    "root_cause": {"type": ["array", "null"], "items": {"type": "string"}},
    "raw_output_excerpt": {"type": "null"},
    "ran_at": {"type": "string", "format": "date-time"},
    "exit_code": {"type": ["integer", "null"]},
    "run_id": {"type": ["string", "null"], "pattern": "^RUN-[A-Za-z0-9_.:-]+$"},
    "execution_evidence": {"type": "array", "items": {"$ref": "#/$defs/evidence"}},
    "evidence_authoritative": {"type": "boolean"},
    "diagnostics": {"type": "array", "items": {"$ref": "#/$defs/diagnostic"}}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "source": {"type": "object", "additionalProperties": false, "required": ["document_id", "revision", "source_digest"], "properties": {"document_id": {"type": "string", "pattern": "^TCDOC-[A-Za-z0-9_.:-]+$"}, "revision": {"type": "integer", "minimum": 1}, "source_digest": {"$ref": "#/$defs/digest"}}},
    "target": {"type": "object", "additionalProperties": false, "required": ["language", "framework", "runner", "command"], "properties": {"language": {"enum": ["python", "java", "unknown"]}, "framework": {"enum": ["pytest", "junit5", "unknown"]}, "runner": {"enum": ["pytest", "maven", "gradle", "not_applicable"]}, "command": {"type": ["string", "null"]}}},
    "environment": {"type": "object", "additionalProperties": false, "required": ["status", "interpreter", "interpreter_path", "working_dir", "missing"], "properties": {"status": {"enum": ["ready", "missing", "partial"]}, "interpreter": {"type": ["string", "null"]}, "interpreter_path": {"type": ["string", "null"]}, "working_dir": {"type": "string"}, "missing": {"type": ["array", "null"], "items": {"type": "string"}}}},
    "diagnostic": {"type": "object", "additionalProperties": false, "required": ["path", "code", "message"], "properties": {"path": {"type": "string"}, "code": {"type": "string", "minLength": 1}, "message": {"type": "string", "minLength": 1}}},
    "evidence": {"type": "object", "additionalProperties": false, "required": ["run_id", "source_digest", "file_id", "symbol_id", "file_digest", "status"], "properties": {"run_id": {"type": "string", "pattern": "^RUN-[A-Za-z0-9_.:-]+$"}, "source_digest": {"$ref": "#/$defs/digest"}, "file_id": {"type": "string", "pattern": "^FILE-[A-Za-z0-9_.:-]+$"}, "symbol_id": {"type": "string", "pattern": "^SYMBOL-[A-Za-z0-9_.:-]+$"}, "file_digest": {"$ref": "#/$defs/digest"}, "status": {"enum": ["PASSED", "FAILED", "ERROR", "SKIPPED"]}}}
  },
  "allOf": [
    {"if": {"properties": {"verdict": {"const": "PASS"}}, "required": ["verdict"]}, "then": {"properties": {"run_id": {"type": "string"}, "stats": {"type": "object"}, "exit_code": {"type": "integer"}, "execution_evidence": {"minItems": 1}, "evidence_authoritative": {"const": true}}}},
    {"if": {"properties": {"verdict": {"const": "FAIL"}}, "required": ["verdict"]}, "then": {"properties": {"run_id": {"type": "string"}, "stats": {"type": "object"}, "exit_code": {"type": "integer"}, "execution_evidence": {"minItems": 1}}}},
    {"if": {"properties": {"verdict": {"const": "NOT_RUNNABLE"}, "run_id": {"type": "null"}}, "required": ["verdict", "run_id"]}, "then": {"properties": {"stats": {"type": "null"}, "exit_code": {"type": "null"}, "execution_evidence": {"maxItems": 0}, "evidence_authoritative": {"const": false}, "diagnostics": {"minItems": 1}}}},
    {"if": {"properties": {"verdict": {"const": "NOT_RUNNABLE"}, "run_id": {"type": "string"}}, "required": ["verdict", "run_id"]}, "then": {"properties": {"stats": {"type": "object"}, "exit_code": {"type": "integer"}}}}
  ]
}
