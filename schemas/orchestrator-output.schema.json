{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schemas/orchestrator-output.schema.json",
  "title": "Portable orchestrate artifact envelope",
  "type": "object",
  "required": ["schema_version", "stage", "artifacts", "warnings"], "additionalProperties": false,
  "properties": {
    "schema_version": {"const": "2.1.0"}, "stage": {"const": "orchestrate"},
    "artifacts": {
      "type": "object", "required": ["run_tests_verdict", "execution_evidence", "trace_audit"], "additionalProperties": false,
      "properties": {
        "run_tests_verdict": {"type": "object", "required": ["verdict"], "additionalProperties": false, "properties": {"verdict": {"enum": ["PASS", "FAIL", "NOT_RUNNABLE"]}}},
        "execution_evidence": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/evidence"}},
        "trace_audit": {"type": "object", "required": ["verdict", "mappings"], "additionalProperties": false, "properties": {"verdict": {"enum": ["PASS", "FAIL"]}, "mappings": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/trace_mapping"}}}}
      }
    }, "warnings": {"type": "array", "items": {"type": "string", "minLength": 1}}
  },
  "$defs": {
    "evidence": {"type": "object", "required": ["method_id", "verdict", "run_id"], "additionalProperties": false, "properties": {"method_id": {"type": "string", "pattern": "^METHOD-[A-Za-z0-9_.:-]+$"}, "verdict": {"enum": ["PASS", "FAIL", "NOT_RUNNABLE"]}, "run_id": {"type": "string", "pattern": "^RUN-[A-Za-z0-9_.:-]+$"}}},
    "trace_mapping": {"type": "object", "required": ["requirement_id", "test_case_id", "method_id", "evidence_ids"], "additionalProperties": false, "properties": {"requirement_id": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$"}, "test_case_id": {"type": "string", "pattern": "^TC-[A-Za-z0-9_.:-]+$"}, "method_id": {"type": "string", "pattern": "^METHOD-[A-Za-z0-9_.:-]+$"}, "evidence_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^RUN-[A-Za-z0-9_.:-]+$"}}}}
  }
}
