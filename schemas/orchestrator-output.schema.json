{
 "$schema":"https://json-schema.org/draft/2020-12/schema", "$id":"schemas/orchestrator-output.schema.json", "type":"object", "required":["schema_version","stage","artifacts","warnings"], "additionalProperties":false,
 "properties":{"schema_version":{"const":"2.1.0"},"stage":{"const":"orchestrate"},"warnings":{"type":"array","items":{"type":"string"}},"artifacts":{"type":"object","required":["run_tests_verdict","execution_evidence","trace_audit"],"additionalProperties":false,"properties":{"run_tests_verdict":{"$ref":"#/$defs/run"},"execution_evidence":{"type":"array","items":{"$ref":"#/$defs/evidence"}},"trace_audit":{"$ref":"#/$defs/trace"}}}},
 "allOf":[
  {"if":{"properties":{"artifacts":{"properties":{"run_tests_verdict":{"properties":{"verdict":{"const":"PASS"}}}}}}},"then":{"properties":{"artifacts":{"properties":{"execution_evidence":{"minItems":1,"items":{"properties":{"verdict":{"const":"PASS"}}}},"trace_audit":{"properties":{"verdict":{"const":"PASS"},"mappings":{"minItems":1},"errors":{"maxItems":0}}}}}}}},
  {"if":{"properties":{"artifacts":{"properties":{"run_tests_verdict":{"properties":{"verdict":{"const":"FAIL"}}}}}}},"then":{"properties":{"artifacts":{"properties":{"trace_audit":{"properties":{"verdict":{"const":"FAIL"},"errors":{"minItems":1}}}}}}}},
  {"if":{"properties":{"artifacts":{"properties":{"run_tests_verdict":{"properties":{"verdict":{"const":"NOT_RUNNABLE"}}}}}}},"then":{"properties":{"artifacts":{"properties":{"execution_evidence":{"maxItems":0},"trace_audit":{"properties":{"verdict":{"const":"FAIL"},"mappings":{"maxItems":0},"errors":{"minItems":1}}}}}}}}
