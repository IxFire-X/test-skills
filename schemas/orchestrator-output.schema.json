{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schemas/orchestrator-output.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "stage", "artifacts", "warnings"],
  "properties": {
    "schema_version": {"const": "3.0.0"},
    "stage": {"const": "orchestrate"},
    "artifacts": {"type": "object", "additionalProperties": false, "required": ["orchestration_result"], "properties": {"orchestration_result": {"$ref": "#/$defs/result"}}},
    "warnings": {"type": "array", "items": {"type": "string", "minLength": 1}}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "source": {"type": "object", "additionalProperties": false, "required": ["document_id", "revision", "source_digest"], "properties": {"document_id": {"type": "string", "pattern": "^TCDOC-[a-z0-9](?:[a-z0-9_.-]*[a-z0-9_-])?$", "maxLength": 102}, "revision": {"type": "integer", "minimum": 1, "maximum": 2147483647}, "source_digest": {"$ref": "#/$defs/digest"}}},
    "receipt": {"type": "object", "additionalProperties": false, "required": ["document_id", "revision", "csv_profile", "json_path", "markdown_path", "csv_path", "document_sha256", "markdown_sha256", "csv_sha256"], "properties": {"document_id": {"type": "string", "pattern": "^TCDOC-[a-z0-9](?:[a-z0-9_.-]*[a-z0-9_-])?$", "maxLength": 102}, "revision": {"type": "integer", "minimum": 1, "maximum": 2147483647}, "csv_profile": {"const": "zephyr-scale-step-row-24-v1"}, "json_path": {"type": "string", "minLength": 1}, "markdown_path": {"type": "string", "minLength": 1}, "csv_path": {"type": "string", "minLength": 1}, "document_sha256": {"$ref": "#/$defs/digest"}, "markdown_sha256": {"$ref": "#/$defs/digest"}, "csv_sha256": {"$ref": "#/$defs/digest"}}},
    "result": {"type": "object", "additionalProperties": false, "required": ["effective_source", "effective_bundle_receipt", "automation_source", "autotest_review_source", "run_source", "trace_source", "automation_status", "autotest_review_verdict", "run_verdict", "final_status"], "properties": {"effective_source": {"$ref": "#/$defs/source"}, "effective_bundle_receipt": {"$ref": "#/$defs/receipt"}, "automation_source": {"$ref": "#/$defs/source"}, "autotest_review_source": {"$ref": "#/$defs/source"}, "run_source": {"anyOf": [{"$ref": "#/$defs/source"}, {"type": "null"}]}, "trace_source": {"$ref": "#/$defs/source"}, "automation_status": {"enum": ["GENERATED", "BLOCKED"]}, "autotest_review_verdict": {"const": "ПРИНЯТО"}, "run_verdict": {"enum": ["PASS", "FAIL", "NOT_RUNNABLE", null]}, "final_status": {"enum": ["PASS", "PASS_WITH_MANUAL_REMAINDER", "MANUAL_ONLY", "BLOCKED", "FAIL", "NOT_RUNNABLE"]}}, "allOf": [
      {"if": {"properties": {"automation_status": {"const": "BLOCKED"}}}, "then": {"properties": {"run_source": {"type": "null"}, "run_verdict": {"type": "null"}, "final_status": {"const": "BLOCKED"}}}},
      {"if": {"properties": {"final_status": {"const": "BLOCKED"}}}, "then": {"properties": {"automation_status": {"const": "BLOCKED"}, "run_source": {"type": "null"}, "run_verdict": {"type": "null"}}}},
      {"if": {"properties": {"final_status": {"const": "MANUAL_ONLY"}}}, "then": {"properties": {"automation_status": {"const": "GENERATED"}, "run_source": {"type": "null"}, "run_verdict": {"type": "null"}}}},
      {"if": {"properties": {"final_status": {"enum": ["PASS", "PASS_WITH_MANUAL_REMAINDER"]}}}, "then": {"properties": {"automation_status": {"const": "GENERATED"}, "run_source": {"$ref": "#/$defs/source"}, "run_verdict": {"const": "PASS"}}}},
      {"if": {"properties": {"final_status": {"const": "FAIL"}}}, "then": {"properties": {"run_source": {"$ref": "#/$defs/source"}, "run_verdict": {"const": "FAIL"}}}},
      {"if": {"properties": {"final_status": {"const": "NOT_RUNNABLE"}}}, "then": {"properties": {"automation_status": {"const": "GENERATED"}, "run_source": {"$ref": "#/$defs/source"}, "run_verdict": {"const": "NOT_RUNNABLE"}}}}
    ]}
  }
}
