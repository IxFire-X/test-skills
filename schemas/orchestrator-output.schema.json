{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schemas/orchestrator-output.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "stage", "artifacts", "warnings"],
  "properties": {
    "schema_version": {"const": "5.0.0"},
    "stage": {"const": "orchestrate"},
    "artifacts": {"type": "object", "additionalProperties": false, "required": ["orchestration_result"], "properties": {"orchestration_result": {"$ref": "#/$defs/result"}}},
    "warnings": {"type": "array", "items": {"type": "string", "minLength": 1}}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "source": {"type": "object", "additionalProperties": false, "required": ["document_id", "revision", "source_digest"], "properties": {"document_id": {"type": "string", "pattern": "^TCDOC-[a-z0-9](?:[a-z0-9_.-]*[a-z0-9_-])?$", "maxLength": 102}, "revision": {"type": "integer", "minimum": 1, "maximum": 2147483647}, "source_digest": {"$ref": "#/$defs/digest"}}},
    "receipt": {"type": "object", "additionalProperties": false, "required": ["document_id", "revision", "csv_profile", "json_path", "preview_path", "csv_path", "document_sha256", "preview_sha256", "csv_sha256"], "properties": {"document_id": {"type": "string", "pattern": "^TCDOC-[a-z0-9](?:[a-z0-9_.-]*[a-z0-9_-])?$", "maxLength": 102}, "revision": {"type": "integer", "minimum": 1, "maximum": 2147483647}, "csv_profile": {"enum": ["zephyr-scale-step-row-24-v1", "zephyr-scale-step-row-24-v2", "zephyr-scale-step-row-24-v3", "zephyr-scale-step-row-24-v4", "zephyr-scale-step-row-24-v5"]}, "json_path": {"type": "string", "minLength": 1}, "preview_path": {"type": "string", "minLength": 1}, "csv_path": {"type": "string", "minLength": 1}, "document_sha256": {"$ref": "#/$defs/digest"}, "preview_sha256": {"$ref": "#/$defs/digest"}, "csv_sha256": {"$ref": "#/$defs/digest"}}},
    "lifecycle": {"type": "object", "additionalProperties": false, "required": ["projection", "verification"], "properties": {"projection": {"const": "PRE_FINALIZATION"}, "verification": {"enum": ["PASS", "FAIL", "UNKNOWN", "NOT_RUNNABLE", "NOT_APPLICABLE"]}}},
    "result": {"type": "object", "additionalProperties": false, "required": ["tc_review_candidate_source", "tc_review_effective_source", "effective_source", "effective_bundle_receipt", "automation_source", "autotest_review_source", "automation_sha256", "autotest_review_sha256", "run_source", "trace_source", "trace_sha256", "automation_status", "autotest_review_verdict", "run_verdict", "lifecycle"], "properties": {"tc_review_candidate_source": {"$ref": "#/$defs/source"}, "tc_review_effective_source": {"$ref": "#/$defs/source"}, "effective_source": {"$ref": "#/$defs/source"}, "effective_bundle_receipt": {"$ref": "#/$defs/receipt"}, "automation_source": {"$ref": "#/$defs/source"}, "autotest_review_source": {"$ref": "#/$defs/source"}, "automation_sha256": {"$ref": "#/$defs/digest"}, "autotest_review_sha256": {"$ref": "#/$defs/digest"}, "run_source": {"anyOf": [{"$ref": "#/$defs/source"}, {"type": "null"}]}, "trace_source": {"$ref": "#/$defs/source"}, "trace_sha256": {"$ref": "#/$defs/digest"}, "automation_status": {"enum": ["GENERATED", "BLOCKED"]}, "autotest_review_verdict": {"const": "ПРИНЯТО"}, "run_verdict": {"enum": ["PASS", "FAIL", "UNKNOWN", "NOT_RUNNABLE", null]}, "lifecycle": {"$ref": "#/$defs/lifecycle"}}}
  }
}
