{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schemas/orchestrator-output.schema.json",
  "type": "object",
  "required": [
    "schema_version",
    "stage",
    "artifacts",
    "warnings"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "2.1.0"
    },
    "stage": {
      "const": "orchestrate"
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "artifacts": {
      "type": "object",
      "required": [
        "run_tests_verdict",
        "execution_evidence",
        "trace_audit"
      ],
      "additionalProperties": false,
      "properties": {
        "run_tests_verdict": {
          "$ref": "#/$defs/run"
        },
        "execution_evidence": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/evidence"
          }
        },
        "trace_audit": {
          "$ref": "#/$defs/trace"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "artifacts": {
            "properties": {
              "run_tests_verdict": {
                "properties": {
                  "verdict": {
                    "const": "PASS"
                  }
                }
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "artifacts": {
            "properties": {
              "run_tests_verdict": {
                "properties": {
                  "exit_code": {
                    "const": 0
                  },
                  "command": {
                    "minLength": 1
                  },
                  "runner": {
                    "minLength": 1
                  }
                }
              },
              "execution_evidence": {
                "minItems": 1,
                "items": {
                  "properties": {
                    "verdict": {
                      "const": "PASS"
                    }
                  }
                }
              },
              "trace_audit": {
                "type": "object"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "artifacts": {
            "properties": {
              "trace_audit": {
                "properties": {
                  "verdict": {
                    "const": "PASS"
                  }
                }
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "artifacts": {
            "properties": {
              "trace_audit": {
                "properties": {
                  "mappings": {
                    "minItems": 1
                  },
                  "errors": {
                    "maxItems": 0
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "artifacts": {
            "properties": {
              "trace_audit": {
                "properties": {
                  "verdict": {
                    "const": "FAIL"
                  }
                }
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "artifacts": {
            "properties": {
              "trace_audit": {
                "properties": {
                  "errors": {
                    "minItems": 1
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "artifacts": {
            "properties": {
              "run_tests_verdict": {
                "properties": {
                  "verdict": {
                    "const": "FAIL"
                  }
                }
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "artifacts": {
            "properties": {
              "run_tests_verdict": {
                "properties": {
                  "exit_code": {
                    "not": {
                      "const": 0
                    }
                  },
                  "command": {
                    "minLength": 1
                  },
                  "runner": {
                    "minLength": 1
                  }
                }
              },
              "execution_evidence": {
                "anyOf": [
                  {
                    "maxItems": 0
                  },
                  {
                    "contains": {
                      "properties": {
                        "verdict": {
                          "const": "FAIL"
                        }
                      }
                    }
                  }
                ]
              },
              "trace_audit": {
                "properties": {
                  "verdict": {
                    "const": "FAIL"
                  },
                  "errors": {
                    "minItems": 1
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "artifacts": {
            "properties": {
              "run_tests_verdict": {
                "properties": {
                  "verdict": {
                    "const": "NOT_RUNNABLE"
                  }
                }
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "artifacts": {
            "properties": {
              "run_tests_verdict": {
                "not": {
                  "anyOf": [
                    {
                      "required": [
                        "command"
                      ]
                    },
                    {
                      "required": [
                        "runner"
                      ]
                    },
                    {
                      "required": [
                        "exit_code"
                      ]
                    }
                  ]
                }
              },
              "execution_evidence": {
                "maxItems": 0
              },
              "trace_audit": {
                "properties": {
                  "verdict": {
                    "const": "FAIL"
                  },
                  "mappings": {
                    "maxItems": 0
                  },
                  "errors": {
                    "minItems": 1
                  }
                }
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "run": {
      "type": "object",
      "required": [
        "verdict",
        "reason"
      ],
      "additionalProperties": false,
      "properties": {
        "verdict": {
          "enum": [
            "PASS",
            "FAIL",
            "NOT_RUNNABLE"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "command": {
          "type": "string"
        },
        "runner": {
          "type": "string"
        },
        "exit_code": {
          "type": "integer"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "verdict": {
                "enum": [
                  "PASS",
                  "FAIL"
                ]
              }
            }
          },
          "then": {
            "required": [
              "command",
              "runner",
              "exit_code"
            ]
          }
        }
      ]
    },
    "evidence": {
      "type": "object",
      "required": [
        "method_id",
        "verdict",
        "run_id"
      ],
      "additionalProperties": false,
      "properties": {
        "method_id": {
          "type": "string",
          "pattern": "^METHOD-[A-Za-z0-9_.:-]+$"
        },
        "verdict": {
          "enum": [
            "PASS",
            "FAIL"
          ]
        },
        "run_id": {
          "type": "string",
          "pattern": "^RUN-[A-Za-z0-9_.:-]+$"
        }
      }
    },
    "trace": {
      "type": "object",
      "required": [
        "verdict",
        "mappings",
        "errors"
      ],
      "additionalProperties": false,
      "properties": {
        "verdict": {
          "enum": [
            "PASS",
            "FAIL"
          ]
        },
        "mappings": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "object",
            "required": [
              "requirement_id",
              "test_case_id",
              "file_id",
              "method_id",
              "evidence_ids"
            ],
            "additionalProperties": false,
            "properties": {
              "requirement_id": {
                "type": "string",
                "pattern": "^REQ-[A-Za-z0-9_.:-]+$"
              },
              "test_case_id": {
                "type": "string",
                "pattern": "^TC-[A-Za-z0-9_.:-]+$"
              },
              "file_id": {
                "type": "string",
                "pattern": "^FILE-[A-Za-z0-9_.:-]+$"
              },
              "method_id": {
                "type": "string",
                "pattern": "^METHOD-[A-Za-z0-9_.:-]+$"
              },
              "evidence_ids": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "pattern": "^RUN-[A-Za-z0-9_.:-]+$"
                }
              }
            }
          }
        },
        "errors": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
