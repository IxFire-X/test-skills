{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schemas/terminal-run-receipt.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "artifact", "prefix_ledger_sha256", "repository_id", "selected_module", "run_mode", "change_input", "analytics_sha256", "source_snapshot_sha256", "fingerprints", "artifacts", "acceptance"],
  "properties": {
    "schema_version": {"const": "1.0.0"}, "artifact": {"const": "terminal-run-receipt"}, "prefix_ledger_sha256": {"$ref": "#/$defs/digest"},
    "repository_id": {"type": ["null", "string"], "pattern": "^sha256:[0-9a-f]{64}$"}, "selected_module": {"type": "string", "minLength": 1},
    "run_mode": {"enum": ["FULL", "CHANGE_SET"]}, "change_input": {"type": ["null", "object"]},
    "analytics_sha256": {"$ref": "#/$defs/digest"}, "source_snapshot_sha256": {"$ref": "#/$defs/digest"}, "fingerprints": {"$ref": "#/$defs/fingerprints"},
    "artifacts": {"$ref": "#/$defs/artifacts"}, "acceptance": {"$ref": "#/$defs/acceptance"}
  },
  "allOf": [
    {"if": {"properties": {"run_mode": {"const": "FULL"}}, "required": ["run_mode"]}, "then": {"properties": {"change_input": {"anyOf": [{"type": "null"}, {"not": {"properties": {"input_kind": {"const": "git_range"}}, "required": ["input_kind"]}}]}}}},
    {"if": {"properties": {"run_mode": {"const": "CHANGE_SET"}}, "required": ["run_mode"]}, "then": {"required": ["repository_id", "change_input"], "properties": {"repository_id": {"$ref": "#/$defs/digest"}, "change_input": {"$ref": "#/$defs/change_input"}}}},
    {"if": {"properties": {"repository_id": {"type": "null"}}, "required": ["repository_id"]}, "then": {"properties": {"run_mode": {"const": "FULL"}, "change_input": {"type": "null"}}}, "else": {"properties": {"change_input": {"$ref": "#/$defs/change_input"}}}},
    {"if": {"properties": {"acceptance": {"properties": {"test_case_review_verdict": {"const": "UNCHANGED_BASELINE"}}, "required": ["test_case_review_verdict"]}}, "required": ["acceptance"]}, "then": {"properties": {"artifacts": {"properties": {"validation_report_sha256": {"type": "null"}, "delta_application_receipt_sha256": {"$ref": "#/$defs/digest"}, "unchanged_document_selection_sha256": {"$ref": "#/$defs/digest"}}, "required": ["validation_report_sha256", "delta_application_receipt_sha256", "unchanged_document_selection_sha256"]}}}, "else": {"properties": {"artifacts": {"properties": {"validation_report_sha256": {"$ref": "#/$defs/digest"}, "delta_application_receipt_sha256": {"type": "null"}, "unchanged_document_selection_sha256": {"type": "null"}}, "required": ["validation_report_sha256", "delta_application_receipt_sha256", "unchanged_document_selection_sha256"]}}}}
  ],
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "git_object": {"type": "string", "pattern": "^[0-9a-f]{40}([0-9a-f]{24})?$"},
    "git_target": {"type": "object", "additionalProperties": false, "required": ["commit", "tree"], "properties": {"commit": {"$ref": "#/$defs/git_object"}, "tree": {"$ref": "#/$defs/git_object"}}},
    "git_head": {"type": "object", "additionalProperties": false, "required": ["input_kind", "repository_id", "target"], "properties": {"input_kind": {"const": "git_head"}, "repository_id": {"$ref": "#/$defs/digest"}, "target": {"$ref": "#/$defs/git_target"}}},
    "git_range": {"type": "object", "additionalProperties": false, "required": ["input_kind", "repository_id", "base", "target"], "properties": {"input_kind": {"const": "git_range"}, "repository_id": {"$ref": "#/$defs/digest"}, "base": {"$ref": "#/$defs/git_target"}, "target": {"$ref": "#/$defs/git_target"}}},
    "git_worktree": {"type": "object", "additionalProperties": false, "required": ["input_kind", "repository_id", "base", "target_snapshot_sha256"], "properties": {"input_kind": {"const": "git_worktree"}, "repository_id": {"$ref": "#/$defs/digest"}, "base": {"$ref": "#/$defs/git_target"}, "target_snapshot_sha256": {"$ref": "#/$defs/digest"}}},
    "patch_manifest": {"type": "object", "additionalProperties": false, "required": ["input_kind", "repository_id", "base_snapshot_sha256", "target_snapshot_sha256"], "properties": {"input_kind": {"const": "patch_manifest"}, "repository_id": {"$ref": "#/$defs/digest"}, "base_snapshot_sha256": {"$ref": "#/$defs/digest"}, "target_snapshot_sha256": {"$ref": "#/$defs/digest"}}},
    "change_input": {"oneOf": [{"$ref": "#/$defs/git_head"}, {"$ref": "#/$defs/git_range"}, {"$ref": "#/$defs/git_worktree"}, {"$ref": "#/$defs/patch_manifest"}]},
    "fingerprints": {"type": "object", "additionalProperties": false, "required": ["pipeline_contract_sha256", "policy_bundle_sha256", "tool_bundle_sha256", "schema_bundle_sha256"], "properties": {"pipeline_contract_sha256": {"$ref": "#/$defs/digest"}, "policy_bundle_sha256": {"$ref": "#/$defs/digest"}, "tool_bundle_sha256": {"$ref": "#/$defs/digest"}, "schema_bundle_sha256": {"$ref": "#/$defs/digest"}}},
    "artifacts": {"type": "object", "additionalProperties": false, "required": ["technical_test_inventory_sha256", "authorized_behavior_sources_sha256", "change_scope_receipt_sha256", "managed_behavior_context_sha256", "changed_behavior_context_sha256", "behavior_source_accounting_sha256", "behavior_context_receipt_sha256", "technical_test_classification_sha256", "classification_review_sha256", "effective_technical_evidence_sha256", "validation_report_sha256", "delta_application_receipt_sha256", "unchanged_document_selection_sha256", "effective_document_sha256", "effective_bundle_receipt_sha256", "automation_artifact_sha256", "autotest_review_sha256", "run_result_sha256", "trace_document_sha256", "trace_audit_sha256", "orchestrator_output_sha256"], "properties": {"technical_test_inventory_sha256": {"$ref": "#/$defs/digest"}, "authorized_behavior_sources_sha256": {"$ref": "#/$defs/digest"}, "change_scope_receipt_sha256": {"$ref": "#/$defs/digest"}, "managed_behavior_context_sha256": {"$ref": "#/$defs/digest"}, "changed_behavior_context_sha256": {"$ref": "#/$defs/digest"}, "behavior_source_accounting_sha256": {"$ref": "#/$defs/digest"}, "behavior_context_receipt_sha256": {"$ref": "#/$defs/digest"}, "technical_test_classification_sha256": {"$ref": "#/$defs/digest"}, "classification_review_sha256": {"$ref": "#/$defs/digest"}, "effective_technical_evidence_sha256": {"$ref": "#/$defs/digest"}, "validation_report_sha256": {"type": ["null", "string"], "pattern": "^sha256:[0-9a-f]{64}$"}, "delta_application_receipt_sha256": {"type": ["null", "string"], "pattern": "^sha256:[0-9a-f]{64}$"}, "unchanged_document_selection_sha256": {"type": ["null", "string"], "pattern": "^sha256:[0-9a-f]{64}$"}, "effective_document_sha256": {"$ref": "#/$defs/digest"}, "effective_bundle_receipt_sha256": {"$ref": "#/$defs/digest"}, "automation_artifact_sha256": {"$ref": "#/$defs/digest"}, "autotest_review_sha256": {"$ref": "#/$defs/digest"}, "run_result_sha256": {"type": ["null", "string"], "pattern": "^sha256:[0-9a-f]{64}$"}, "trace_document_sha256": {"$ref": "#/$defs/digest"}, "trace_audit_sha256": {"$ref": "#/$defs/digest"}, "orchestrator_output_sha256": {"$ref": "#/$defs/digest"}}},
    "acceptance": {"type": "object", "additionalProperties": false, "required": ["classification_verdict", "test_case_review_verdict", "autotest_review_verdict", "trace_verdict", "final_status", "source_drift"], "properties": {"classification_verdict": {"enum": ["ПРИНЯТО", "ТРЕБУЕТ ДОРАБОТКИ", "AUTO_FIX_APPLIED"]}, "test_case_review_verdict": {"enum": ["ПРИНЯТО", "ТРЕБУЕТ ДОРАБОТКИ", "AUTO_FIX_APPLIED", "UNCHANGED_BASELINE"]}, "autotest_review_verdict": {"enum": ["ПРИНЯТО", "ТРЕБУЕТ ДОРАБОТКИ", "AUTO_FIX_APPLIED"]}, "trace_verdict": {"enum": ["PASS", "FAIL", "BLOCKED"]}, "final_status": {"enum": ["PASS", "PASS_WITH_MANUAL_REMAINDER", "MANUAL_ONLY", "BLOCKED", "FAIL", "NOT_RUNNABLE"]}, "source_drift": {"type": "boolean"}}}
  }
}
