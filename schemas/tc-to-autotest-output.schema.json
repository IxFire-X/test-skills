{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schemas/tc-to-autotest-output.schema.json",
  "type": "object",
  "required": [
    "schema_version",
    "stage",
    "artifacts",
    "warnings"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "2.1.0"
    },
    "stage": {
      "const": "tc-to-autotest"
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "artifacts": {
      "type": "object",
      "required": [
        "automation_matrix",
        "generated_test_files",
        "generated_test_methods"
      ],
      "additionalProperties": false,
      "properties": {
        "automation_matrix": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "test_case_id",
              "generated_file_ids",
              "generated_method_ids"
            ],
            "additionalProperties": false,
            "properties": {
              "test_case_id": {
                "type": "string",
                "pattern": "^TC-[A-Za-z0-9_.:-]+$"
              },
              "generated_file_ids": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "pattern": "^FILE-[A-Za-z0-9_.:-]+$"
                }
              },
              "generated_method_ids": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "pattern": "^METHOD-[A-Za-z0-9_.:-]+$"
                }
              }
            }
          }
        },
        "generated_test_files": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "id",
              "path",
              "language",
              "framework",
              "content_digest"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^FILE-[A-Za-z0-9_.:-]+$"
              },
              "path": {
                "type": "string",
                "minLength": 1
              },
              "language": {
                "type": "string",
                "minLength": 1
              },
              "framework": {
                "type": "string",
                "minLength": 1
              },
              "content_digest": {
                "type": "string",
                "pattern": "^sha256:[a-fA-F0-9]{64}$"
              }
            }
          }
        },
        "generated_test_methods": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "id",
              "file_id",
              "test_case_ids",
              "requirement_ids",
              "name",
              "content_digest"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^METHOD-[A-Za-z0-9_.:-]+$"
              },
              "file_id": {
                "type": "string",
                "pattern": "^FILE-[A-Za-z0-9_.:-]+$"
              },
              "test_case_ids": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "pattern": "^TC-[A-Za-z0-9_.:-]+$"
                }
              },
              "requirement_ids": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "pattern": "^REQ-[A-Za-z0-9_.:-]+$"
                }
              },
              "name": {
                "type": "string",
                "minLength": 1
              },
              "content_digest": {
                "type": "string",
                "pattern": "^sha256:[a-fA-F0-9]{64}$"
              }
            }
          }
        }
      }
    }
  }
}
