{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schemas/skillsrc.schema.json",
  "title": "Portable .skillsrc manifest",
  "type": "object",
  "required": ["project"], "additionalProperties": false,
  "properties": {
    "version": {"type": "string", "minLength": 1},
    "project": {"type": "object", "required": ["name", "language"], "additionalProperties": false, "properties": {"name": {"type": "string", "minLength": 1}, "language": {"enum": ["java", "python", "go", "typescript", "kotlin"]}, "framework": {"type": "string", "minLength": 1}, "build_tool": {"enum": ["maven", "gradle", "pip", "poetry", "go-mod", "npm", "yarn"]}, "type": {"enum": ["platform-billing", "sdk-library", "microservice", "web-app", "cli-tool"]}}},
    "paths": {"type": "object", "additionalProperties": false, "properties": {"source": {"type": "string"}, "tests": {"type": "string"}, "resources": {"type": "string"}, "docs": {"type": "string"}}},
    "test": {"type": "object", "additionalProperties": false, "properties": {"framework": {"enum": ["junit5", "testng", "kotest", "pytest", "unittest", "jest", "mocha", "go-testing"]}, "api_client": {"type": "string"}, "database": {"type": "string"}}},
    "methodology": {"enum": ["sdd", "tdd", "bdd", "mixed"]},
    "sdd": {"type": "object", "additionalProperties": false, "properties": {"openapi": {"type": "string"}, "asyncapi": {"type": "string"}, "domain": {"type": "string"}, "requirements": {"type": "string"}, "architecture": {"type": "string"}}},
    "resolution": {"type": "object", "additionalProperties": false, "properties": {"analytics_vs_code": {"enum": ["analytics_wins", "code_wins", "ask_user", "strict"]}, "status_conflict": {"enum": ["ask_user", "auto_promote", "auto_demote"]}, "skillsrc_vs_scan": {"enum": ["skillsrc_wins", "scan_wins", "ask_user", "merge"]}}},
    "contracts": {"type": "object", "additionalProperties": false, "properties": {"status_markers_version": {"type": "string"}}},
    "skills_registry": {
      "type": "object",
      "description": "Documented extension point: skill IDs are manifest-defined.",
      "additionalProperties": {"$ref": "#/$defs/skill"}
    }
  },
  "$defs": {
    "skill": {"type": "object", "required": ["name", "path", "description"], "additionalProperties": false, "properties": {"name": {"type": "string", "minLength": 1}, "path": {"type": "string", "minLength": 1}, "skill_file": {"type": "string", "minLength": 1}, "description": {"type": "string", "minLength": 1}, "tags": {"type": "array", "items": {"type": "string", "pattern": "^@[a-z-]+$"}}, "triggers": {"type": "array", "items": {"type": "string", "minLength": 1}}, "input_contract": {"type": "string", "minLength": 1}, "output_contract": {"type": "string", "minLength": 1}}}
  }
}
