{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schemas/changed-behavior-context.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "artifact", "run_mode", "source", "requirements", "requirement_sources", "stable_requirement_links", "retired_requirements"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "artifact": {"const": "changed-behavior-context"},
    "run_mode": {"enum": ["FULL", "CHANGE_SET"]},
    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["behavior_context_receipt_sha256", "baseline_context_sha256"],
      "properties": {"behavior_context_receipt_sha256": {"$ref": "#/$defs/digest"}, "baseline_context_sha256": {"oneOf": [{"$ref": "#/$defs/digest"}, {"type": "null"}]}}
    },
    "requirements": {"type": "array", "items": {"$ref": "canonical-test-document.schema.json#/$defs/requirement"}},
    "requirement_sources": {"type": "array", "items": {"$ref": "#/$defs/requirement-source"}},
    "stable_requirement_links": {"type": "array", "items": {"$ref": "#/$defs/stable-link"}},
    "retired_requirements": {"type": "array", "items": {"$ref": "behavior-context-receipt.schema.json#/$defs/requirement-retirement"}}
  },
  "allOf": [
    {"if": {"properties": {"run_mode": {"const": "FULL"}}}, "then": {"properties": {"source": {"properties": {"baseline_context_sha256": {"type": "null"}}}, "stable_requirement_links": {"maxItems": 0}, "retired_requirements": {"maxItems": 0}}}, "else": {"properties": {"source": {"properties": {"baseline_context_sha256": {"$ref": "#/$defs/digest"}}}}}}
  ],
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "requirement-source": {"type": "object", "additionalProperties": false, "required": ["requirement_id", "source_ids"], "properties": {"requirement_id": {"type": "string", "pattern": "^REQ-[A-Za-z0-9_.:-]+$"}, "source_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}}},
    "stable-link": {"type": "object", "additionalProperties": false, "required": ["requirement_id", "baseline_requirement_sha256", "source_ids"], "properties": {"requirement_id": {"type": "string", "pattern": "^REQ-[A-Za-z0-9_.:-]+$"}, "baseline_requirement_sha256": {"$ref": "#/$defs/digest"}, "source_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}}}
  }
}
