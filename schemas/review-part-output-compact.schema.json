{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schemas/review-part-output-compact.schema.json",
  "title": "Compact review part answer (compact-v1)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "plan_digest", "snapshot_digest", "part_id", "input_digest"],
  "oneOf": [
    {"required": ["coverage", "findings", "corrections", "lint_dispositions", "required_checks"], "not": {"required": ["invocation_failure"]}},
    {"required": ["invocation_failure"], "not": {"anyOf": [{"required": ["coverage"]}, {"required": ["findings"]}, {"required": ["corrections"]}, {"required": ["lint_dispositions"]}, {"required": ["required_checks"]}]}}
  ],
  "properties": {
    "schema_version": {"enum": ["2.0.0", "2.1.0"]},
    "invocation_failure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["failure_class", "reason", "try"],
      "properties": {"failure_class": {"enum": ["TRANSPORT", "CONTENT"]}, "reason": {"type": "string", "minLength": 1}, "try": {"enum": [1, 2, 3]}}
    },
    "plan_digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "snapshot_digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "part_id": {"type": "string", "pattern": "^part-[0-9]{6}$"},
    "input_digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "coverage": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["area_id", "status", "refs", "note"],
        "properties": {
          "area_id": {"type": "string", "minLength": 1},
          "status": {"enum": ["CHECKED", "UNCHECKED"]},
          "refs": {"type": "array", "items": {"type": "string", "minLength": 1, "maxLength": 120}, "minItems": 1, "maxItems": 3, "uniqueItems": true},
          "note": {"type": "string", "maxLength": 200}
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["severity", "code", "related_ids", "message"],
        "properties": {
          "severity": {"enum": ["BLOCKING", "WARNING", "INFO"]},
          "code": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{1,63}$"},
          "related_ids": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1, "uniqueItems": true},
          "message": {"type": "string", "minLength": 1, "maxLength": 600},
          "analyst_question": {"type": "string", "minLength": 1, "maxLength": 300, "description": "2.1.0: the problem is in the requirement, not in the case; a question for the analyst."}
        }
      }
    },
    "corrections": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["target_id", "field", "before", "after", "why"],
        "properties": {
          "target_id": {"type": "string", "minLength": 1},
          "field": {"type": "string", "pattern": "^[a-z_]+(?:\\.[a-z_]+)?(?:\\[(?:0|[1-9][0-9]*)\\])?$"},
          "before": {"type": "string"},
          "after": {"type": "string"},
          "why": {"type": "string", "minLength": 1, "maxLength": 600}
        }
      }
    },
    "lint_dispositions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["lint_id", "decision", "reason"],
        "properties": {
          "lint_id": {"type": "string", "pattern": "^LINT-[0-9A-F]{10}$"},
          "decision": {"enum": ["confirmed", "rejected"]},
          "reason": {"type": "string", "minLength": 1, "maxLength": 200}
        }
      }
    },
    "required_checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["reason"],
        "anyOf": [{"required": ["case_ids"]}, {"required": ["requirement_ids"]}],
        "properties": {
          "case_ids": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1, "uniqueItems": true},
          "requirement_ids": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1, "uniqueItems": true},
          "reason": {"type": "string", "minLength": 1, "maxLength": 600}
        }
      }
    }
  }
}
