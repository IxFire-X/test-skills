{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schemas/review-plan-compact.schema.json",
  "title": "Compact review plan (compact-v1)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "mode",
    "snapshot",
    "input_byte_budget",
    "lint",
    "parts",
    "digest"
  ],
  "properties": {
    "schema_version": {
      "const": "2.0.0"
    },
    "mode": {
      "const": "compact-v1"
    },
    "snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "review_kind",
        "revision",
        "snapshot_digest",
        "instructions",
        "response_reserve_bytes",
        "projection_digest"
      ],
      "properties": {
        "review_kind": {
          "enum": [
            "tc-reviewer",
            "autotest-reviewer"
          ]
        },
        "revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2
        },
        "snapshot_digest": {
          "$ref": "#/$defs/digest"
        },
        "instructions": {
          "type": "string",
          "minLength": 1
        },
        "response_reserve_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "projection_digest": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "input_byte_budget": {
      "type": "integer",
      "minimum": 1
    },
    "lint": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/lint"
      }
    },
    "parts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/part"
      },
      "minItems": 1
    },
    "carried": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "area",
          "fingerprint",
          "from_attempt_id",
          "from_plan_digest",
          "from_part_id"
        ],
        "properties": {
          "area": {
            "$ref": "#/$defs/area"
          },
          "fingerprint": {
            "$ref": "#/$defs/digest"
          },
          "from_attempt_id": {
            "type": "string",
            "pattern": "^[0-9a-f]{32}$"
          },
          "from_plan_digest": {
            "$ref": "#/$defs/digest"
          },
          "from_part_id": {
            "oneOf": [
              {
                "type": "string",
                "pattern": "^part-[0-9]{6}$"
              },
              {
                "type": "null"
              }
            ]
          }
        }
      }
    },
    "digest": {
      "$ref": "#/$defs/digest"
    },
    "check_policy": {"const": "merged-after-base-v1", "description": "Additional check parts: added once after every base part answered, one per target, at most a quarter of the base parts (2026-10-08)."},
    "slice_failures": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "file_id",
          "reason"
        ],
        "properties": {
          "file_id": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "lint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lint_id",
        "rule",
        "case_ids",
        "related_ids",
        "message"
      ],
      "properties": {
        "lint_id": {
          "type": "string",
          "pattern": "^LINT-[0-9A-F]{10}$"
        },
        "rule": {
          "type": "string",
          "minLength": 1
        },
        "case_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          },
          "uniqueItems": true
        },
        "related_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "message": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "area": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "area_id",
        "kind",
        "targets",
        "fingerprint"
      ],
      "properties": {
        "area_id": {
          "$ref": "#/$defs/id"
        },
        "kind": {
          "enum": [
            "source",
            "local",
            "cross",
            "support"
          ]
        },
        "targets": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "question": {
          "type": "string",
          "minLength": 1
        },
        "fingerprint": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "part": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "part_id",
        "case_ids",
        "blocks",
        "source",
        "areas",
        "carried_area_ids",
        "lint_ids",
        "text",
        "requested_check",
        "input_byte_count",
        "blocked_reason"
      ],
      "properties": {
        "part_id": {
          "type": "string",
          "pattern": "^part-[0-9]{6}$"
        },
        "case_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          },
          "uniqueItems": true
        },
        "blocks": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/id"
            }
          }
        },
        "source": {
          "type": "boolean"
        },
        "areas": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/area"
          },
          "minItems": 1
        },
        "carried_area_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          },
          "uniqueItems": true
        },
        "lint_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^LINT-[0-9A-F]{10}$"
          },
          "uniqueItems": true
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "code_ranges": {
          "type": "array",
          "items": {
            "type": "array",
            "prefixItems": [
              {
                "type": "integer",
                "minimum": 1
              },
              {
                "type": "integer",
                "minimum": 1
              },
              {
                "type": "string",
                "minLength": 1
              }
            ],
            "items": false,
            "minItems": 3
          }
        },
        "requested_check": {
          "oneOf": [
            {
              "$ref": "#/$defs/digest"
            },
            {
              "type": "null"
            }
          ]
        },
        "input_byte_count": {
          "type": "integer",
          "minimum": 1
        },
        "blocked_reason": {
          "enum": [
            null,
            "REVIEW_CONTEXT_LIMIT"
          ]
        },
        "case_ranges": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "array",
              "prefixItems": [
                {
                  "type": "integer",
                  "minimum": 1
                },
                {
                  "type": "integer",
                  "minimum": 1
                },
                {
                  "type": "string",
                  "minLength": 1
                }
              ],
              "items": false,
              "minItems": 3
            }
          }
        }
      }
    }
  }
}
