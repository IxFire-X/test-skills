{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schemas/behavior-context-receipt.schema.json",
  "oneOf": [{"$ref": "#/$defs/v1"}, {"$ref": "#/$defs/v2"}],
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "v1-fragment": {"type": "object", "additionalProperties": false, "required": ["fragment_id", "source_id", "item_id"], "properties": {"fragment_id": {"type": "string", "pattern": "^FRAGMENT-[0-9a-f]{64}$"}, "source_id": {"type": "string", "minLength": 1}, "item_id": {"type": "string", "pattern": "^ITEM-[0-9]{6}$"}}},
    "v1-outcome": {"type": "object", "additionalProperties": false, "required": ["source_id", "domain_key", "outcome"], "properties": {"source_id": {"type": "string", "minLength": 1}, "domain_key": {"type": "string", "minLength": 1}, "outcome": {"enum": ["behavior_fragments", "no_supported_observable_fact"]}}},
    "v1": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "selected_module", "authorized_behavior_sources_sha256", "context_plan_sha256", "batch_result_sha256s", "fragment_registry", "source_outcomes"],
      "properties": {"schema_version": {"const": "1.0.0"}, "selected_module": {"type": "string", "minLength": 1}, "authorized_behavior_sources_sha256": {"$ref": "#/$defs/digest"}, "context_plan_sha256": {"$ref": "#/$defs/digest"}, "batch_result_sha256s": {"type": "array", "items": {"$ref": "#/$defs/digest"}}, "fragment_registry": {"type": "array", "items": {"$ref": "#/$defs/v1-fragment"}}, "source_outcomes": {"type": "array", "items": {"$ref": "#/$defs/v1-outcome"}}}
    },
    "unchanged-binding": {"type": "object", "additionalProperties": false, "required": ["source_id", "baseline_content_digest", "current_content_digest"], "properties": {"source_id": {"type": "string", "minLength": 1}, "baseline_content_digest": {"$ref": "#/$defs/digest"}, "current_content_digest": {"$ref": "#/$defs/digest"}}},
    "v2-fragment": {"type": "object", "additionalProperties": false, "required": ["fragment_id", "source_id", "item_id", "effect"], "properties": {"fragment_id": {"type": "string", "pattern": "^FRAGMENT-[0-9a-f]{64}$"}, "source_id": {"type": "string", "minLength": 1}, "item_id": {"type": "string", "pattern": "^ITEM-[0-9]{6}$"}, "effect": {"enum": ["full", "added", "modified", "retired"]}}},
    "v2-outcome": {"type": "object", "additionalProperties": false, "required": ["source_id", "domain_key", "outcome"], "properties": {"source_id": {"type": "string", "minLength": 1}, "domain_key": {"type": "string", "minLength": 1}, "outcome": {"enum": ["behavior_fragments", "changed_behavior_fragments", "preserved_behavior", "no_supported_observable_fact"]}}},
    "retirement-support": {"type": "object", "additionalProperties": false, "required": ["status", "surviving_source_ids", "retirement_fragment_ids"], "properties": {"status": {"const": "NO_SURVIVING_SOURCE_SUPPORT"}, "surviving_source_ids": {"type": "array", "maxItems": 0}, "retirement_fragment_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^FRAGMENT-[0-9a-f]{64}$"}}}},
    "requirement-retirement": {"type": "object", "additionalProperties": false, "required": ["object_kind", "object_id", "baseline_object_sha256", "reason", "support_evidence"], "properties": {"object_kind": {"const": "requirement"}, "object_id": {"type": "string", "pattern": "^REQ-[A-Za-z0-9_.:-]+$"}, "baseline_object_sha256": {"$ref": "#/$defs/digest"}, "reason": {"enum": ["REQUIREMENT_NO_LONGER_OBSERVABLE", "REQUIREMENT_MERGED"]}, "support_evidence": {"$ref": "#/$defs/retirement-support"}}},
    "assurance": {"type": "object", "additionalProperties": false, "required": ["review_mode", "independent_promotion_count", "sequential_promotion_count", "reworked_batch_count"], "properties": {"review_mode": {"enum": ["SEQUENTIAL", "INDEPENDENT"]}, "independent_promotion_count": {"type": "integer", "minimum": 0}, "sequential_promotion_count": {"type": "integer", "minimum": 0}, "reworked_batch_count": {"type": "integer", "minimum": 0}}},
    "v2": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "artifact", "run_mode", "selected_module", "baseline_receipt_sha256", "scope_receipt_sha256", "authorized_behavior_sources_sha256", "context_plan_sha256", "promotion_sha256s", "unchanged_source_bindings", "fragment_registry", "source_outcomes", "changed_requirement_ids", "retired_requirements", "assurance"],
      "properties": {
        "schema_version": {"const": "2.0.0"}, "artifact": {"const": "behavior-context-receipt"}, "run_mode": {"enum": ["FULL", "CHANGE_SET"]}, "selected_module": {"type": "string", "minLength": 1},
        "baseline_receipt_sha256": {"oneOf": [{"$ref": "#/$defs/digest"}, {"type": "null"}]}, "scope_receipt_sha256": {"$ref": "#/$defs/digest"}, "authorized_behavior_sources_sha256": {"$ref": "#/$defs/digest"}, "context_plan_sha256": {"$ref": "#/$defs/digest"},
        "promotion_sha256s": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/digest"}}, "unchanged_source_bindings": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/unchanged-binding"}}, "fragment_registry": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/v2-fragment"}}, "source_outcomes": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/v2-outcome"}},
        "changed_requirement_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^REQ-[A-Za-z0-9_.:-]+$"}}, "retired_requirements": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/requirement-retirement"}}, "assurance": {"$ref": "#/$defs/assurance"}
      },
      "allOf": [{"if": {"properties": {"run_mode": {"const": "FULL"}}}, "then": {"properties": {"baseline_receipt_sha256": {"type": "null"}, "unchanged_source_bindings": {"maxItems": 0}, "retired_requirements": {"maxItems": 0}, "fragment_registry": {"items": {"properties": {"effect": {"const": "full"}}}}, "source_outcomes": {"items": {"properties": {"outcome": {"enum": ["behavior_fragments", "no_supported_observable_fact"]}}}}}}, "else": {"properties": {"baseline_receipt_sha256": {"$ref": "#/$defs/digest"}, "fragment_registry": {"items": {"properties": {"effect": {"enum": ["added", "modified", "retired"]}}}}, "source_outcomes": {"items": {"properties": {"outcome": {"enum": ["changed_behavior_fragments", "preserved_behavior", "no_supported_observable_fact"]}}}}}}}]
    }
  }
}
