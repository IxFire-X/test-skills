{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schemas/tc-generator-output.schema.json",
  "title": "Portable tc-generator artifact envelope",
  "type": "object",
  "required": ["schema_version", "stage", "artifacts", "warnings"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": "2.1.0"}, "stage": {"const": "tc-generator"},
    "artifacts": {
      "type": "object", "required": ["requirements", "test_cases", "coverage"], "additionalProperties": false,
      "properties": {
        "requirements": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/requirement"}},
        "test_cases": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/test_case"}},
        "coverage": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/coverage"}}
      }
    },
    "warnings": {"type": "array", "items": {"type": "string", "minLength": 1}}
  },
  "$defs": {
    "requirement": {"type": "object", "required": ["id", "text", "provenance"], "additionalProperties": false, "properties": {"id": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$"}, "text": {"type": "string", "minLength": 1}, "provenance": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}}},
    "test_case": {"type": "object", "required": ["id", "requirement_ids", "title"], "additionalProperties": false, "properties": {"id": {"type": "string", "pattern": "^TC-[A-Za-z0-9_.:-]+$"}, "requirement_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$"}}, "title": {"type": "string", "minLength": 1}}},
    "coverage": {"type": "object", "required": ["requirement_id", "test_case_ids"], "additionalProperties": false, "properties": {"requirement_id": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$"}, "test_case_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^TC-[A-Za-z0-9_.:-]+$"}}}}
  }
}
