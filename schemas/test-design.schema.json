{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schemas/test-design.schema.json",
  "title": "Test design artifact (test-design-v1)",
  "description": "Parameters, equivalence partitions, boundary values and decision/state/error rules of the source requirements, before any test case. tools/test_design.validate_design checks references, coverage of every requirement and the rules this schema cannot express.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "stage", "artifacts", "warnings"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "stage": {"const": "test-design"},
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["parameters", "partitions", "boundaries", "rules", "not_designed"],
      "properties": {
        "parameters": {"type": "array", "items": {"$ref": "#/$defs/parameter"}},
        "partitions": {"type": "array", "items": {"$ref": "#/$defs/partition"}},
        "boundaries": {"type": "array", "items": {"$ref": "#/$defs/boundary"}},
        "rules": {"type": "array", "items": {"$ref": "#/$defs/rule"}},
        "not_designed": {"type": "array", "items": {"$ref": "#/$defs/not_designed"}}
      }
    },
    "warnings": {"type": "array", "items": {"type": "string", "minLength": 1, "maxLength": 600}}
  },
  "$defs": {
    "requirement_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^SREQ-[A-Za-z0-9_.:-]+$"}
    },
    "text": {"type": "string", "minLength": 1, "maxLength": 2000},
    "parameter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "requirement_ids", "kind", "notes"],
      "properties": {
        "id": {"type": "string", "pattern": "^P-[0-9]{3,}$"},
        "name": {"$ref": "#/$defs/text"},
        "requirement_ids": {"$ref": "#/$defs/requirement_ids"},
        "kind": {"enum": ["ordered", "enum", "boolean", "text", "structure"]},
        "notes": {"type": "string", "maxLength": 2000},
        "single_class_reason": {"$ref": "#/$defs/text"}
      }
    },
    "partition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "parameter_id", "valid", "condition", "requirement_ids"],
      "properties": {
        "id": {"type": "string", "pattern": "^EQ-[0-9]{3,}$"},
        "parameter_id": {"type": "string", "pattern": "^P-[0-9]{3,}$"},
        "valid": {"type": "boolean"},
        "condition": {"$ref": "#/$defs/text"},
        "requirement_ids": {"$ref": "#/$defs/requirement_ids"}
      }
    },
    "boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "partition_id", "value", "side"],
      "properties": {
        "id": {"type": "string", "pattern": "^BV-[0-9]{3,}$"},
        "partition_id": {"type": "string", "pattern": "^EQ-[0-9]{3,}$"},
        "value": {"$ref": "#/$defs/text"},
        "side": {"enum": ["min", "max", "just_inside", "just_outside"]}
      }
    },
    "condition": {
      "oneOf": [
        {"type": "object", "additionalProperties": false, "required": ["ref"], "properties": {"ref": {"type": "string", "pattern": "^(EQ|BV)-[0-9]{3,}$"}}},
        {"type": "object", "additionalProperties": false, "required": ["text"], "properties": {"text": {"$ref": "#/$defs/text"}}}
      ]
    },
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "conditions", "expected", "requirement_ids"],
      "properties": {
        "id": {"type": "string", "pattern": "^DR-[0-9]{3,}$"},
        "kind": {"enum": ["decision", "state", "error"]},
        "conditions": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/condition"}},
        "expected": {"$ref": "#/$defs/text"},
        "requirement_ids": {"$ref": "#/$defs/requirement_ids"}
      }
    },
    "not_designed": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requirement_id", "reason"],
      "properties": {
        "requirement_id": {"type": "string", "pattern": "^SREQ-[A-Za-z0-9_.:-]+$"},
        "reason": {"$ref": "#/$defs/text"}
      }
    }
  }
}
