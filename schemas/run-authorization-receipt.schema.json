{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"schemas/run-authorization-receipt.schema.json","type":"object","additionalProperties":false,"required":["schema_version","run_id","request_id","policy_profile","execution_requested","digest"],"properties":{"schema_version":{"const":"1.0.0"},"run_id":{"type":"string","pattern":"^[0-9a-f]{32}$"},"request_id":{"$ref":"#/$defs/safe_label"},"policy_profile":{"enum":["cases-only-v1","local-pilot-v1"]},"execution_requested":{"type":"boolean"},"host_id":{"$ref":"#/$defs/safe_label"},"digest":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},"mutation_requested":{"type":"boolean","description":"Run-scoped consent to the opt-in MUTATION stage (local-pilot-v1 only)."},"require_driver_isolation":{"type":"boolean","description":"Accept only review parts run by a driver-launched process (isolation_evidence DRIVER_PROCESS)."}},"$defs":{"safe_label":{"type":"string","pattern":"^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$","allOf":[{"not":{"pattern":"[tT][oO][kK][eE][nN]|[sS][eE][cC][rR][eE][tT]|[cC][rR][eE][dD][eE][nN][tT][iI][aA][lL]|[pP][aA][sS][sS][wW][oO][rR][dD]|[bB][eE][aA][rR][eE][rR]|[pP][rR][oO][mM][pP][tT]|[aA][pP][iI]_[kK][eE][yY]"}},{"not":{"pattern":"^[gG][hH][pP]_|^[gG][iI][tT][hH][uU][bB]_[pP][aA][tT]_|^[sS][kK]-"}},{"not":{"pattern":"^[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+$"}},{"not":{"pattern":"^(?=.{24,}$)(?=.*[a-z])(?=.*[A-Z])(?=.*[0-9])[A-Za-z0-9_-]+$"}}]}},"allOf":[{"if":{"properties":{"policy_profile":{"const":"cases-only-v1"}},"required":["policy_profile"]},"then":{"properties":{"execution_requested":{"const":false}}}},{"if":{"properties":{"policy_profile":{"const":"local-pilot-v1"}},"required":["policy_profile"]},"then":{"properties":{"execution_requested":{"const":true}}}},{"if":{"required":["mutation_requested"]},"then":{"properties":{"policy_profile":{"const":"local-pilot-v1"},"mutation_requested":{"const":true}}}},{"if":{"required":["require_driver_isolation"]},"then":{"properties":{"requi