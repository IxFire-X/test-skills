{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schemas/context-marker-output.schema.json",
  "title": "Managed V5 or promoted V6 context-marker artifact envelope",
  "oneOf": [{"$ref": "#/$defs/v5"}, {"$ref": "#/$defs/v6"}],
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "envelope-base": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "stage", "artifacts", "warnings"],
      "properties": {"schema_version": {"type": "string"}, "stage": {"const": "context-marker"}, "artifacts": {"type": "object"}, "warnings": {"type": "array", "maxItems": 0, "items": {"type": "string"}}}
    },
    "v5": {
      "allOf": [
        {"$ref": "#/$defs/envelope-base"},
        {"properties": {"schema_version": {"const": "5.0.0"}, "artifacts": {"type": "object", "additionalProperties": false, "required": ["managed_behavior_context", "behavior_source_accounting"], "properties": {"managed_behavior_context": {"$ref": "#/$defs/managed"}, "behavior_source_accounting": {"$ref": "#/$defs/accounting"}}}}}
      ]
    },
    "v6": {
      "allOf": [
        {"$ref": "#/$defs/envelope-base"},
        {"properties": {"schema_version": {"const": "6.0.0"}, "artifacts": {"type": "object", "additionalProperties": false, "required": ["managed_behavior_context", "changed_behavior_context", "behavior_source_accounting"], "properties": {"managed_behavior_context": {"$ref": "#/$defs/managed"}, "changed_behavior_context": {"$ref": "changed-behavior-context.schema.json"}, "behavior_source_accounting": {"$ref": "#/$defs/accounting"}}}}}
      ]
    },
    "managed": {
      "type": "object", "additionalProperties": false,
      "required": ["authorized_behavior_sources_sha256", "requirements", "product_sources", "requirement_sources"],
      "properties": {"authorized_behavior_sources_sha256": {"$ref": "#/$defs/digest"}, "requirements": {"type": "array", "items": {"$ref": "canonical-test-document.schema.json#/$defs/requirement"}}, "product_sources": {"type": "array", "items": {"$ref": "#/$defs/product"}}, "requirement_sources": {"type": "array", "items": {"$ref": "#/$defs/requirement-source"}}}
    },
    "product": {"type": "object", "additionalProperties": false, "required": ["source_id", "kind", "path", "content_digest", "summary"], "properties": {"source_id": {"type": "string"}, "kind": {"const": "product_file"}, "path": {"type": "string", "minLength": 1}, "content_digest": {"$ref": "#/$defs/digest"}, "summary": {"type": "string", "minLength": 1}}},
    "requirement-source": {"type": "object", "additionalProperties": false, "required": ["requirement_id", "source_ids"], "properties": {"requirement_id": {"type": "string"}, "source_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}}}},
    "accounting": {
      "type": "object", "additionalProperties": false,
      "required": ["authorized_behavior_sources_sha256", "context_receipt_sha256", "source_dispositions", "behavior_fragment_groups"],
      "properties": {"authorized_behavior_sources_sha256": {"$ref": "#/$defs/digest"}, "context_receipt_sha256": {"$ref": "#/$defs/digest"}, "source_dispositions": {"type": "array", "items": {"oneOf": [{"$ref": "#/$defs/represented"}, {"$ref": "#/$defs/excluded"}]}}, "behavior_fragment_groups": {"type": "array", "items": {"$ref": "#/$defs/group"}}}
    },
    "represented": {"type": "object", "additionalProperties": false, "required": ["source_id", "disposition", "requirement_ids"], "properties": {"source_id": {"type": "string"}, "disposition": {"const": "represented"}, "requirement_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}}}},
    "excluded": {"type": "object", "additionalProperties": false, "required": ["source_id", "disposition", "reason"], "properties": {"source_id": {"type": "string"}, "disposition": {"const": "no_supported_observable_fact"}, "reason": {"const": "no_supported_actor_operation_or_outcome_after_full_review"}}},
    "group": {"type": "object", "additionalProperties": false, "required": ["group_id", "fragment_ids", "requirement_ids"], "properties": {"group_id": {"type": "string", "minLength": 1}, "fragment_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^FRAGMENT-[0-9a-f]{64}$"}}, "requirement_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}}}}
  }
}
