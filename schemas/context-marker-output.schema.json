{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schemas/context-marker-output.schema.json",
  "title": "Managed V4 context-marker artifact envelope",
  "type": "object",
  "required": ["schema_version", "stage", "artifacts", "warnings"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": "4.0.0"},
    "stage": {"const": "context-marker"},
    "artifacts": {
      "type": "object",
      "required": ["managed_behavior_context"],
      "additionalProperties": false,
      "properties": {"managed_behavior_context": {"$ref": "#/$defs/managed_behavior_context"}}
    },
    "warnings": {"type": "array", "maxItems": 0, "items": {"type": "string"}}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "nonempty": {"type": "string", "minLength": 1, "pattern": ".*\\S.*"},
    "product_source": {
      "type": "object", "additionalProperties": false,
      "required": ["source_id", "kind", "path", "content_digest", "summary"],
      "properties": {
        "source_id": {"type": "string", "pattern": "^SOURCE-[0-9a-f]{64}$"},
        "kind": {"const": "product_file"},
        "path": {"$ref": "#/$defs/nonempty"},
        "content_digest": {"$ref": "#/$defs/digest"},
        "summary": {"$ref": "#/$defs/nonempty"}
      }
    },
    "requirement_source": {
      "type": "object", "additionalProperties": false,
      "required": ["requirement_id", "source_ids"],
      "properties": {
        "requirement_id": {"type": "string", "pattern": "^REQ-[A-Za-z0-9_.:-]+$"},
        "source_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    },
    "managed_behavior_context": {
      "type": "object", "additionalProperties": false,
      "required": ["authorized_behavior_sources_sha256", "requirements", "product_sources", "requirement_sources"],
      "properties": {
        "authorized_behavior_sources_sha256": {"$ref": "#/$defs/digest"},
        "requirements": {"type": "array", "minItems": 1, "items": {"$ref": "schemas/canonical-test-document.schema.json#/$defs/requirement"}},
        "product_sources": {"type": "array", "items": {"$ref": "#/$defs/product_source"}},
        "requirement_sources": {"type": "array", "items": {"$ref": "#/$defs/requirement_source"}}
      }
    }
  }
}
