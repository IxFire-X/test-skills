{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schemas/context-marker-output.schema.json",
  "title": "Portable 5.0.0 context-marker artifact envelope",
  "type": "object",
  "required": ["schema_version", "stage", "artifacts", "warnings"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": "5.0.0"},
    "stage": {"const": "context-marker"},
    "artifacts": {
      "type": "object",
      "required": ["analytics_documentation", "source_code_and_diff"],
      "additionalProperties": false,
      "properties": {
        "analytics_documentation": {
          "type": "object", "required": ["requirements"], "additionalProperties": false,
          "properties": {"requirements": {"type": "array", "minItems": 1, "items": {"$ref": "canonical-test-document.schema.json#/$defs/source_requirement"}}, "case_links": {"description": "FaT-IMP3: scan --cases with --docs — every case row of the CSV linked to the source requirements it checks; none only with a reason.", "type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["row", "source_requirement_ids"], "properties": {"row": {"type": "integer", "minimum": 1}, "source_requirement_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^SREQ-[A-Za-z0-9_.:-]+$"}}, "reason": {"type": "string", "minLength": 1}}}}}
        },
        "source_code_and_diff": {
          "type": "object", "required": ["sources"], "additionalProperties": false,
          "properties": {"sources": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/inline_provenance_string"}}}
        }
      }
    },
    "warnings": {"type": "array", "items": {"$ref": "#/$defs/inline_provenance_string"}}
  },
  "$defs": {
    "inline_provenance_string": {"type": "string", "pattern": "^.+ — .+$"}
  }
}
