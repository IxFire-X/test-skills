{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schemas/tc-reviewer-output.schema.json",
  "title": "Portable tc-reviewer artifact envelope",
  "type": "object",
  "required": ["schema_version", "stage", "artifacts", "warnings"], "additionalProperties": false,
  "properties": {
    "schema_version": {"const": "2.1.0"}, "stage": {"const": "tc-reviewer"},
    "artifacts": {
      "type": "object", "required": ["validation_report", "accepted_test_cases", "corrected_test_cases"], "additionalProperties": false,
      "properties": {
        "validation_report": {"$ref": "#/$defs/review_report"},
        "accepted_test_cases": {"type": "array", "items": {"$ref": "#/$defs/test_case"}},
        "corrected_test_cases": {"type": "array", "items": {"$ref": "#/$defs/test_case"}}
      }
    }, "warnings": {"type": "array", "items": {"type": "string", "minLength": 1}}
  },
  "allOf": [
    {"if": {"properties": {"artifacts": {"properties": {"validation_report": {"properties": {"verdict": {"const": "ПРИНЯТО"}}}}}}}, "then": {"properties": {"artifacts": {"properties": {"accepted_test_cases": {"minItems": 1}}}}}},
    {"if": {"properties": {"artifacts": {"properties": {"validation_report": {"properties": {"verdict": {"const": "AUTO_FIX_APPLIED"}}}}}}}, "then": {"properties": {"artifacts": {"properties": {"corrected_test_cases": {"minItems": 1}}}}}}
  ],
  "$defs": {
    "review_report": {"type": "object", "required": ["verdict", "reviewed_test_case_ids"], "additionalProperties": false, "properties": {"verdict": {"enum": ["ПРИНЯТО", "AUTO_FIX_APPLIED", "ТРЕБУЕТ ДОРАБОТКИ"]}, "reviewed_test_case_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^TC-[A-Za-z0-9_.:-]+$"}}}},
    "test_case": {"type": "object", "required": ["id", "requirement_ids", "title"], "additionalProperties": false, "properties": {"id": {"type": "string", "pattern": "^TC-[A-Za-z0-9_.:-]+$"}, "requirement_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$"}}, "title": {"type": "string", "minLength": 1}}}
  }
}
