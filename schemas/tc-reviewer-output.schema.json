{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schemas/tc-reviewer-output.schema.json",
  "type": "object",
  "required": ["schema_version", "stage", "artifacts", "warnings"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": "5.0.0"},
    "stage": {"const": "tc-reviewer"},
    "artifacts": {
      "type": "object",
      "required": ["validation_report"],
      "additionalProperties": false,
      "properties": {
        "validation_report": {"$ref": "#/$defs/review"},
        "successor_document": {"$ref": "canonical-test-document.schema.json"},
        "successor_edits": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/successor_edit"}}
      }
    },
    "warnings": {"type": "array", "items": {"type": "string", "minLength": 1}}
  },
  "allOf": [
    {
      "if": {"properties": {"artifacts": {"properties": {"validation_report": {"properties": {"verdict": {"const": "ПРИНЯТО"}}, "required": ["verdict"]}}, "required": ["validation_report"]}}, "required": ["artifacts"]},
      "then": {"properties": {"artifacts": {"not": {"anyOf": [{"required": ["successor_document"]}, {"required": ["successor_edits"]}]}, "properties": {"validation_report": {"properties": {"findings": {"maxItems": 0}, "corrections": {"maxItems": 0}}}}}}}
    },
    {
      "if": {"properties": {"artifacts": {"properties": {"validation_report": {"properties": {"verdict": {"const": "AUTO_FIX_APPLIED"}}, "required": ["verdict"]}}, "required": ["validation_report"]}}, "required": ["artifacts"]},
      "then": {"properties": {"artifacts": {"oneOf": [{"required": ["successor_document"]}, {"required": ["successor_edits"]}], "properties": {"validation_report": {"properties": {"corrections": {"minItems": 1}, "findings": {"not": {"contains": {"properties": {"severity": {"const": "BLOCKING"}}, "required": ["severity"]}}}}}}}}}
    },
    {
      "if": {"properties": {"artifacts": {"properties": {"validation_report": {"properties": {"verdict": {"const": "ТРЕБУЕТ ДОРАБОТКИ"}}, "required": ["verdict"]}}, "required": ["validation_report"]}}, "required": ["artifacts"]},
      "then": {"properties": {"artifacts": {"not": {"anyOf": [{"required": ["successor_document"]}, {"required": ["successor_edits"]}]}, "properties": {"validation_report": {"properties": {"findings": {"contains": {"properties": {"severity": {"const": "BLOCKING"}}, "required": ["severity"]}}, "corrections": {"maxItems": 0}}}}}}}
    }
  ],
  "$defs": {
    "successor_edit": {
      "type": "object", "required": ["correction_id", "case_id", "field", "old", "new"], "additionalProperties": false,
      "properties": {
        "correction_id": {"type": "string", "pattern": "^FIX-[A-Za-z0-9_.:-]+$"},
        "case_id": {"type": "string", "pattern": "^TC-[A-Za-z0-9_.:-]+$"},
        "field": {"enum": ["title", "objective", "precondition", "action", "test_data", "expectation"]},
        "step_id": {"type": "string", "pattern": "^STEP-[A-Za-z0-9_.:-]+$"},
        "expectation_id": {"type": "string", "pattern": "^EXP-[A-Za-z0-9_.:-]+$"},
        "index": {"type": "integer", "minimum": 0},
        "old": {"type": "string"},
        "new": {"type": "string", "minLength": 1}
      }
    },
    "finding": {
      "type": "object", "required": ["severity", "code", "message", "evidence", "related_ids"], "additionalProperties": false,
      "properties": {
        "severity": {"enum": ["BLOCKING", "WARNING", "INFO"]},
        "code": {"type": "string", "minLength": 1},
        "message": {"type": "string", "minLength": 1},
        "evidence": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "related_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    },
    "correction": {
      "type": "object", "required": ["id", "correction_kind", "related_ids", "description", "evidence"], "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "pattern": "^FIX-[A-Za-z0-9_.:-]+$"}, "correction_kind": {"enum": ["MECHANICAL", "DESTRUCTIVE", "PARTIAL", "CHOICE"]},
        "related_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "description": {"type": "string", "minLength": 1},
        "evidence": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    },
    "candidate": {
      "type": "object", "required": ["document_id", "revision", "document_sha256"], "additionalProperties": false,
      "properties": {
        "document_id": {"type": "string", "pattern": "^TCDOC-[A-Za-z0-9_.:-]+$"},
        "revision": {"type": "integer", "minimum": 1},
        "document_sha256": {"$ref": "canonical-test-document.schema.json#/$defs/digest"}
      }
    },
    "effective": {
      "oneOf": [{"$ref": "#/$defs/candidate"}, {"type": "null"}]
    },
    "review": {
      "type": "object", "required": ["verdict", "candidate", "effective", "reviewed_case_ids", "findings", "corrections"], "additionalProperties": false,
      "properties": {
        "verdict": {"enum": ["ПРИНЯТО", "AUTO_FIX_APPLIED", "ТРЕБУЕТ ДОРАБОТКИ"]},
        "candidate": {"$ref": "#/$defs/candidate"},
        "effective": {"$ref": "#/$defs/effective"},
        "reviewed_case_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^TC-[A-Za-z0-9_.:-]+$"}},
        "findings": {"type": "array", "items": {"$ref": "#/$defs/finding"}},
        "corrections": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/correction"}}
      }
    }
  }
}
