{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schemas/materialization-command-receipt.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "run_id", "attempt_id", "policy_profile", "baseline_digest", "generated_delta_digest", "execution_request_digest", "language", "module", "working_directory", "command", "command_digest", "report_location", "inventory_taken_ns", "report_inventory", "challenge", "files", "digest"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "kind": {"const": "materialization-command"},
    "run_id": {"type": "string", "pattern": "^[0-9a-f]{32}$"},
    "attempt_id": {"type": "string", "pattern": "^[0-9a-f]{32}$"},
    "policy_profile": {"const": "local-pilot-v1"},
    "baseline_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "generated_delta_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "execution_request_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "language": {"enum": ["python", "java"]},
    "module": {"type": "string", "minLength": 1},
    "working_directory": {"type": "string", "minLength": 1},
    "command": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "command_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "report_location": {"type": "string", "minLength": 1},
    "inventory_taken_ns": {"type": "integer", "minimum": 0},
    "report_inventory": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "mtime_ns", "size", "sha256"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "mtime_ns": {"type": "integer", "minimum": 0},
          "size": {"type": "integer", "minimum": 0},
          "sha256": {"type": "string", "minLength": 1}
        }
      }
    },
    "challenge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "name", "value"],
      "properties": {
        "kind": {"enum": ["system-property", "suite-name", "not_available"]},
        "name": {"type": ["string", "null"]},
        "value": {"type": ["string", "null"]}
      }
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "content_digest"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "content_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
        }
      }
    },
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  }
}
