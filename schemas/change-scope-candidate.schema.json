  "allOf":[{"if":{"properties":{"generation":{"const":1}}},"then":{"properties":{"parent_candidate_sha256":{"type":"null"},"triggering_audit_sha256s":{"maxItems":0}}},"else":{"properties":{"parent_candidate_sha256":{"$ref":"#/$defs/digest"},"triggering_audit_sha256s":{"minItems":1,"maxItems":1}}}},{"if":{"properties":{"run_mode":{"const":"FULL"}}},"then":{"properties":{"baseline_receipt_sha256":{"type":"null"},"change_input_sha256":{"type":"null"}}},"else":{"properties":{"baseline_receipt_sha256":{"$ref":"#/$defs/digest"},"change_input_sha256":{"$ref":"#/$defs/digest"}}}}],
