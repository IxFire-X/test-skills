{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schemas/pipeline.schema.json",
  "title": "Portable Testing Skills Pipeline Contract",
  "type": "object",
  "required": ["version", "pipeline", "artifacts", "steps", "verdicts", "transitions", "capabilities", "artifact_policy", "traceability", "projections"],
  "properties": {
    "$schema": {"type": "string"},
    "version": {"type": "string", "minLength": 1},
    "pipeline": {"type": "string", "minLength": 1},
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "description"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
          "description": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "accepts", "forwards", "produces", "rejects"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
          "accepts": {"type": "array", "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"}},
          "forwards": {"type": "array", "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"}},
          "produces": {"type": "array", "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"}},
          "rejects": {"type": "array", "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"}}
        },
        "additionalProperties": false
      }
    },
    "verdicts": {
      "type": "object",
      "required": ["review", "execution"],
      "properties": {
        "review": {"type": "array", "items": {"type": "string"}},
        "execution": {"type": "array", "items": {"type": "string", "enum": ["PASS", "FAIL", "NOT_RUNNABLE"]}}
      },
      "additionalProperties": false
    },
    "transitions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["from", "when", "transform"],
        "properties": {
          "from": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
          "when": {
            "type": "object",
            "required": ["execution_verdict"],
            "properties": {"execution_verdict": {"type": "string", "enum": ["PASS", "FAIL", "NOT_RUNNABLE"]}},
            "additionalProperties": false
          },
          "transform": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["language", "framework", "generation", "review", "execution", "status"],
        "properties": {
          "language": {"type": "string", "enum": ["java", "python", "typescript", "go"]},
          "framework": {"type": "string"},
          "generation": {"type": "boolean"},
          "review": {"type": "boolean"},
          "execution": {"type": "boolean"},
          "status": {"type": "string", "enum": ["supported", "experimental"]}
        },
        "additionalProperties": false
      }
    },
    "artifact_policy": {
      "type": "object",
      "required": ["persistent_root", "generated_test_source"],
      "properties": {
        "persistent_root": {"type": "string", "minLength": 1},
        "generated_test_source": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "traceability": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "projections": {
      "type": "object",
      "required": ["contracts", "pipeline"],
      "properties": {
        "contracts": {"type": "string", "minLength": 1},
        "pipeline": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
