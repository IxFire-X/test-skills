{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schemas/pipeline.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema","version","pipeline","core_skills","skill_files","artifact_registry","schema_registry","controller_schemas","policy_profiles","adapter_registry","stage_registry","projection_profiles","release_qualification","runtime_signatures","event_order","global_event_constraints","reviewer_session_contract","physical_lifecycle","result_axes","result_tuples","acceptance_predicates","exit_priority","projections"],
  "properties": {
    "$schema": {"const":"schemas/pipeline.schema.json"}, "version": {"const":"4.0"}, "pipeline": {"const":"portable-testing-skills-frozen-pilot"},
    "core_skills": {"type":"array","items":{"type":"string","minLength":1},"minItems":6,"uniqueItems":true},
    "skill_files": {"type":"object","additionalProperties":false,"required":["context-marker","tc-generator","tc-reviewer","tc-to-autotest","autotest-reviewer","orchestrate"],"properties":{"context-marker":{"type":"string","minLength":1},"tc-generator":{"type":"string","minLength":1},"tc-reviewer":{"type":"string","minLength":1},"tc-to-autotest":{"type":"string","minLength":1},"autotest-reviewer":{"type":"string","minLength":1},"orchestrate":{"type":"string","minLength":1}}},
    "artifact_registry": {"type":"array","items":{"$ref":"#/$defs/artifact"},"minItems":1,"uniqueItems":true},
    "schema_registry": {"type":"array","items":{"$ref":"#/$defs/schema"},"minItems":1,"uniqueItems":true},
    "controller_schemas": {"type":"array","items":{"type":"string","minLength":1},"minItems":1,"uniqueItems":true},
    "policy_profiles": {"type":"array","items":{"$ref":"#/$defs/policy"},"minItems":2,"uniqueItems":true},
    "adapter_registry": {"type":"array","items":{"$ref":"#/$defs/adapter"},"minItems":3,"uniqueItems":true},
    "stage_registry": {"type":"array","items":{"$ref":"#/$defs/stage"},"minItems":6,"maxItems":6,"uniqueItems":true},
    "projection_profiles": {"type":"array","items":{"$ref":"#/$defs/projection_profile"},"minItems":2,"maxItems":2,"uniqueItems":true},
    "release_qualification": {"$ref":"#/$defs/release_qualification"},
    "runtime_signatures": {"type":"object","additionalProperties":false,"required":["create_run","append_event","create_attempt","derive_state","terminal_result","exit_code"],"properties":{"create_run":{"type":"string","minLength":1},"append_event":{"type":"string","minLength":1},"create_attempt":{"type":"string","minLength":1},"derive_state":{"type":"string","minLength":1},"terminal_result":{"type":"string","minLength":1},"exit_code":{"type":"string","minLength":1}}},
    "event_order": {"type":"array","items":{"type":"object","additionalProperties":false,"required":["event_type"],"properties":{"event_type":{"type":"string","minLength":1}}},"minItems":1},
    "global_event_constraints": {"type":"array","items":{"$ref":"#/$defs/event_constraint"},"minItems":1,"uniqueItems":true},
    "reviewer_session_contract": {"type":"object","additionalProperties":false,"required":["session_count","evidence_pairs","successful_verdicts","pre_verdict_abort","forbidden"],"properties":{"session_count":{"const":"one"},"evidence_pairs":{"type":"object","additionalProperties":false,"required":["minimum","maximum"],"properties":{"minimum":{"const":0},"maximum":{"const":"bounded"}}},"successful_verdicts":{"const":1},"pre_verdict_abort":{"type":"object","additionalProperties":false,"required":["terminal","verdicts"],"properties":{"terminal":{"const":true},"verdicts":{"const":0}}},"forbidden":{"type":"array","items":{"type":"string","minLength":1},"minItems":3,"uniqueItems":true}}},
    "physical_lifecycle": {"type":"array","items":{"type":"string","minLength":1},"minItems":1,"uniqueItems":true},
    "result_axes": {"type":"object","additionalProperties":false,"required":["attempt_state","completion","verification","coverage","reason_code","accepted"],"properties":{"attempt_state":{"$ref":"#/$defs/axis"},"completion":{"$ref":"#/$defs/axis"},"verification":{"$ref":"#/$defs/axis"},"coverage":{"$ref":"#/$defs/axis"},"reason_code":{"$ref":"#/$defs/reason_axis"},"accepted":{"type":"object","additionalProperties":false,"required":["preterminal","terminal"],"properties":{"preterminal":{"const":"absent"},"terminal":{"const":"boolean"}}}}},
    "result_tuples": {"type":"object","additionalProperties":false,"required":["complete_fail","execution_unknown","pre_execution_rework","early_fatal","review_context_limit","invalid_finalization"],"properties":{"complete_fail":{"$ref":"#/$defs/result_tuple"},"execution_unknown":{"$ref":"#/$defs/result_tuple"},"pre_execution_rework":{"$ref":"#/$defs/result_tuple"},"early_fatal":{"$ref":"#/$defs/result_tuple"},"review_context_limit":{"$ref":"#/$defs/result_tuple"},"invalid_finalization":{"$ref":"#/$defs/result_tuple"}}},
    "acceptance_predicates": {"type":"object","additionalProperties":false,"required":["cases-only-v1","local-pilot-v1"],"properties":{"cases-only-v1":{"$ref":"#/$defs/nonempty_string_array"},"local-pilot-v1":{"$ref":"#/$defs/nonempty_string_array"}}},
    "exit_priority": {"type":"array","items":{"$ref":"#/$defs/exit_rule"},"minItems":5,"uniqueItems":true},
    "projections": {"type":"object","additionalProperties":false,"required":["contracts","pipeline"],"properties":{"contracts":{"const":"CONTRACTS.md"},"pipeline":{"const":"PIPELINE.md"}}}
  },
  "$defs": {
    "identifier": {"type":"string","pattern":"^[a-z][a-z0-9_:-]*$"},
    "artifact": {"type":"object","additionalProperties":false,"required":["id","phase","implementation_status","semantic_ready"],"properties":{"id":{"$ref":"#/$defs/identifier"},"phase":{"type":"integer","minimum":1,"maximum":8},"implementation_status":{"enum":["IMPLEMENTED","MIGRATION_PENDING","NOT_IMPLEMENTED"]},"semantic_ready":{"type":"boolean"}},"allOf":[{"if":{"properties":{"implementation_status":{"const":"IMPLEMENTED"}},"required":["implementation_status"]},"then":{"properties":{"semantic_ready":{"const":true}}}},{"if":{"properties":{"implementation_status":{"enum":["MIGRATION_PENDING","NOT_IMPLEMENTED"]}},"required":["implementation_status"]},"then":{"properties":{"semantic_ready":{"const":false}}}}]},
    "schema": {"type":"object","additionalProperties":false,"required":["id","phase","implementation_status","target_version","semantic_ready"],"properties":{"id":{"type":"string","pattern":"^[a-z][a-z0-9-]*\\.schema\\.json$"},"phase":{"type":"integer","minimum":1,"maximum":8},"implementation_status":{"enum":["IMPLEMENTED","MIGRATION_PENDING","NOT_IMPLEMENTED"]},"target_version":{"type":"string","pattern":"^[0-9]+\\.[0-9]+\\.[0-9]+$|^4\\.0$"},"semantic_ready":{"type":"boolean"}},"allOf":[{"if":{"properties":{"phase":{"const":8},"implementation_status":{"const":"IMPLEMENTED"}},"required":["phase","implementation_status"]},"then":{"properties":{"semantic_ready":{"const":true}}}},{"if":{"properties":{"implementation_status":{"enum":["MIGRATION_PENDING","NOT_IMPLEMENTED"]}},"required":["implementation_status"]},"then":{"properties":{"semantic_ready":{"const":false}}}}]},
    "policy": {"type":"object","additionalProperties":false,"required":["id","version","semantic_ready"],"properties":{"id":{"enum":["cases-only-v1","local-pilot-v1"]},"version":{"const":"v1"},"semantic_ready":{"const":true}}},
    "adapter": {"type":"object","additionalProperties":false,"required":["id","phase","implementation_status","version","semantic_ready"],"properties":{"id":{"enum":["pytest:selected-symbols-v1","maven-wrapper:selected-symbols-v1","gradle-wrapper:selected-symbols-v1"]},"phase":{"const":6},"implementation_status":{"const":"IMPLEMENTED"},"version":{"const":"v1"},"semantic_ready":{"const":true}}},
    "stage": {"type":"object","additionalProperties":false,"required":["stage","role","role_policy","cardinality","profiles"],"properties":{"stage":{"enum":["orchestrate","context-marker","tc-generator","tc-reviewer","tc-to-autotest","autotest-reviewer"]},"role":{"enum":["controller","generator","canonical-reviewer","automation-generator","automation-reviewer"]},"role_policy":{"type":"string","pattern":"^[a-z][a-z0-9-]*-v1$"},"cardinality":{"enum":["once","per_batch","once_per_canonical_branch","per_automation_revision"]},"profiles":{"type":"array","items":{"enum":["cases-only-v1","local-pilot-v1"]},"minItems":1,"maxItems":2,"uniqueItems":true}}},
    "projection_profile": {"type":"object","additionalProperties":false,"required":["id","format","mode","tenant_status"],"properties":{"id":{"enum":["zephyr-scale-step-row-24-v4","zephyr-scale-xml-observed-v1"]},"format":{"enum":["csv","xml"]},"mode":{"enum":["default","opt_in_observed"]},"tenant_status":{"const":"N_A"}}},
    "release_qualification": {"type":"object","additionalProperties":false,"required":["package_version","compatibility_contract_version","execution_profile_version","release_eval_policy","scenario_suite","manifest_path","component_state","ready_tuple","not_applicable"],"properties":{"package_version":{"const":"0.5.0-pilot"},"compatibility_contract_version":{"const":"portable-cli-v1"},"execution_profile_version":{"const":"v1"},"release_eval_policy":{"const":"adaptive-1-3-5-v1"},"scenario_suite":{"const":"pilot-critical-v1"},"manifest_path":{"const":"release/manifest.json"},"component_state":{"const":"implemented_unverified"},"ready_tuple":{"const":null},"not_applicable":{"type":"array","prefixItems":[{"const":"company_runner"},{"const":"zephyr_tenant"},{"const":"production_rollback"}],"items":false,"minItems":3,"maxItems":3}}},
    "axis": {"type":"object","additionalProperties":false,"required":["values","nullable"],"properties":{"values":{"type":"array","items":{"type":"string","minLength":1},"minItems":1,"uniqueItems":true},"nullable":{"type":"boolean"}}},
    "reason_axis": {"type":"object","additionalProperties":false,"required":["preterminal","terminal"],"properties":{"preterminal":{"const":"absent"},"terminal":{"const":"written_once"}}},
    "result_tuple": {"type":"object","additionalProperties":false,"properties":{"attempt_state":{"enum":["TERMINAL"]},"completion":{"enum":["COMPLETE","PARTIAL","FATAL"]},"verification":{"enum":["PASS","FAIL","UNKNOWN","NOT_RUNNABLE","NOT_APPLICABLE","PRESERVED"]},"coverage":{"enum":["FULL","MIXED","MANUAL_ONLY","PRESERVED",null]},"reason_code":{"type":"string","minLength":1},"accepted":{"type":"boolean"}}},
    "event_constraint": {"type":"object","additionalProperties":false,"required":["before","after"],"properties":{"before":{"type":"string","minLength":1},"after":{"type":"string","minLength":1},"narrow_exception":{"type":"boolean"}}},
    "exit_rule": {"type":"object","additionalProperties":false,"required":["when","code"],"properties":{"when":{"type":"string","minLength":1},"code":{"enum":[0,1,2,3]}}},
    "nonempty_string_array": {"type":"array","items":{"type":"string","minLength":1},"minItems":1,"uniqueItems":true}
  }
}
