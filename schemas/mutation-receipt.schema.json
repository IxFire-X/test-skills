{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schemas/mutation-receipt.schema.json",
  "title": "Mutation receipt (opt-in MUTATION stage, contract amendments 2026-10-07)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "run_id", "attempt_id", "policy_profile", "digest", "execution_receipt_digest", "status", "reason_code", "message",
               "verification", "tool", "settings", "target_classes", "target_tests", "excluded_methods", "project_inventory", "durations_ms", "report",
               "totals", "cases", "requirements", "source_requirements", "survivor_groups"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "kind": {"const": "mutation-receipt"},
    "run_id": {"type": "string", "pattern": "^[0-9a-f]{32}$"},
    "attempt_id": {"type": "string", "pattern": "^[0-9a-f]{32}$"},
    "policy_profile": {"const": "local-pilot-v1"},
    "digest": {"$ref": "#/$defs/digest"},
    "execution_receipt_digest": {"$ref": "#/$defs/digest"},
    "status": {"enum": ["MEASURED", "NOT_RUNNABLE", "NOT_APPLICABLE"]},
    "reason_code": {"oneOf": [{"type": "null"}, {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{1,63}$"}]},
    "message": {"oneOf": [{"type": "null"}, {"type": "string", "maxLength": 600}]},
    "verification": {"enum": ["PASS", "FAIL", "UNKNOWN", "NOT_RUNNABLE"]},
    "argv_digest": {"$ref": "#/$defs/digest"},
    "tool": {
      "type": "object", "additionalProperties": false, "required": ["name", "version", "plugin_version", "pins_digest", "jars"],
      "properties": {
        "name": {"const": "pitest"}, "version": {"type": "string", "minLength": 1}, "plugin_version": {"type": "string", "minLength": 1},
        "pins_digest": {"$ref": "#/$defs/digest"}, "launcher_version": {"type": "string", "minLength": 1},
        "jars": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["file", "sha256", "pinned"],
                                             "properties": {"file": {"type": "string", "minLength": 1}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "pinned": {"type": "boolean"}}}}
      }
    },
    "settings": {
      "type": "object", "additionalProperties": false, "required": ["threads", "timeout_seconds", "timeout_const_ms", "mutators", "triage_limit"],
      "properties": {
        "threads": {"type": "integer", "minimum": 1}, "timeout_seconds": {"type": "integer", "minimum": 1}, "timeout_const_ms": {"type": "integer", "minimum": 1},
        "mutators": {"const": "DEFAULTS"}, "triage_limit": {"type": "integer", "minimum": 0},
        "target_classes": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    },
    "target_classes": {"$ref": "#/$defs/strings"},
    "target_tests": {"$ref": "#/$defs/strings"},
    "excluded_methods": {"$ref": "#/$defs/strings"},
    "project_inventory": {
      "type": "object", "additionalProperties": false, "required": ["before", "after", "unchanged"],
      "properties": {"before": {"$ref": "#/$defs/digest"}, "after": {"$ref": "#/$defs/digest"}, "unchanged": {"type": "boolean"}}
    },
    "durations_ms": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}, "propertyNames": {"enum": ["stage", "project_classpath", "tool_resolution", "pit"]}},
    "report": {
      "oneOf": [
        {"type": "null"},
        {"type": "object", "additionalProperties": false, "required": ["sha256", "bytes", "mutations"],
         "properties": {"sha256": {"$ref": "#/$defs/digest"}, "bytes": {"type": "integer", "minimum": 0}, "mutations": {"type": "integer", "minimum": 0},
                        "path": {"type": "string", "minLength": 1}}}
      ]
    },
    "totals": {
      "oneOf": [
        {"type": "null"},
        {"type": "object", "additionalProperties": false,
         "required": ["killed", "survived", "no_coverage", "timed_out", "memory_error", "run_error", "non_viable", "not_started", "started"],
         "properties": {"killed": {"$ref": "#/$defs/count"}, "survived": {"$ref": "#/$defs/count"}, "no_coverage": {"$ref": "#/$defs/count"},
                        "timed_out": {"$ref": "#/$defs/count"}, "memory_error": {"$ref": "#/$defs/count"}, "run_error": {"$ref": "#/$defs/count"},
                        "non_viable": {"$ref": "#/$defs/count"}, "not_started": {"$ref": "#/$defs/count"}, "started": {"$ref": "#/$defs/count"}}}
      ]
    },
    "cases": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["case_id", "covered", "killed"],
                                         "properties": {"case_id": {"type": "string", "minLength": 1}, "covered": {"$ref": "#/$defs/count"}, "killed": {"$ref": "#/$defs/count"}}}},
    "requirements": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["requirement_id", "covered", "killed"],
                                                "properties": {"requirement_id": {"type": "string", "minLength": 1}, "covered": {"$ref": "#/$defs/count"}, "killed": {"$ref": "#/$defs/count"}}}},
    "source_requirements": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["source_requirement_id", "covered", "killed"],
                                                       "properties": {"source_requirement_id": {"type": "string", "minLength": 1}, "covered": {"$ref": "#/$defs/count"}, "killed": {"$ref": "#/$defs/count"}}}},
    "survivor_groups": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["group_id", "class", "method", "line", "source_file", "mutants", "covering_methods", "case_ids", "requirement_ids", "source_requirement_ids", "triage"],
        "properties": {
          "group_id": {"type": "string", "pattern": "^MUT-[0-9]{4}$"}, "class": {"type": "string", "minLength": 1}, "method": {"type": "string", "minLength": 1},
          "line": {"type": "integer", "minimum": 0}, "source_file": {"type": "string"},
          "mutants": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["mutator", "description"],
                                                                "properties": {"mutator": {"type": "string", "minLength": 1}, "description": {"type": "string"}}}},
          "covering_methods": {"$ref": "#/$defs/strings"}, "case_ids": {"$ref": "#/$defs/strings"}, "requirement_ids": {"$ref": "#/$defs/strings"},
          "source_requirement_ids": {"$ref": "#/$defs/strings"}, "triage": {"type": "boolean"}
        }
      }
    }
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "count": {"type": "integer", "minimum": 0},
    "strings": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
  }
}
