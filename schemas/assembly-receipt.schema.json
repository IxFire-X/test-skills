{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schemas/assembly-receipt.schema.json",
  "title": "Assembly Receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "plan_digest", "header_digest", "fragment_digests", "document_digest", "pre_review_audit", "warnings", "digest"],
  "properties": {
    "schema_version": {"const": "1.0.0"}, "plan_digest": {"$ref": "#/$defs/digest"}, "header_digest": {"$ref": "#/$defs/digest"},
    "fragment_digests": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["batch_id", "digest"], "properties": {"batch_id": {"type": "string", "pattern": "^BATCH-[a-z0-9-]+$"}, "digest": {"$ref": "#/$defs/digest"}}}},
    "document_digest": {"$ref": "#/$defs/digest"}, "pre_review_audit": {"type": "object", "additionalProperties": false, "required": ["schema", "semantic", "coverage", "provenance"], "properties": {"schema": {"const": "PASS"}, "semantic": {"const": "PASS"}, "coverage": {"const": "PASS"}, "provenance": {"const": "PASS"}}}, "warnings": {"type": "array", "items": {"oneOf": [{"type": "object", "additionalProperties": false, "required": ["code", "fingerprint", "case_ids"], "properties": {"code": {"const": "POSSIBLE_DUPLICATE"}, "fingerprint": {"type": "string", "minLength": 1}, "case_ids": {"type": "array", "minItems": 2, "items": {"type": "string"}}}}, {"description": "FaT-TD: a code hint on the test design, never a stop", "type": "object", "additionalProperties": false, "required": ["code", "requirement_id", "detail"], "properties": {"code": {"enum": ["TD_NEGATIVE_MISSING", "TD_BOUNDARY_MISSING", "TD_PAIR_UNCOVERED", "TD_BOUNDARY_UNDECLARED", "TD_REF_UNKNOWN"]}, "requirement_id": {"type": "string", "pattern": "^CREQ-[A-Za-z0-9_.:-]+$"}, "parameter": {"type": "string", "pattern": "^P-[A-Za-z0-9_.:-]+$"}, "detail": {"type": "string", "minLength": 1, "maxLength": 200}}}, {"description": "FaT-Q: a code hint on a vague expectation of one step, never a stop", "type": "object", "additionalProperties": false, "required": ["code", "case_id", "step_id", "detail"], "properties": {"code": {"enum": ["TD_VAGUE_EXPECTATION", "TD_NEGATIVE_NO_STATE_CHECK", "TD_WEAK_SUCCESS"]}, "case_id": {"type": "string", "pattern": "^TC-[A-Za-z0-9_.:-]+$"}, "step_id": {"type": "string", "pattern": "^STEP-[A-Za-z0-9_.:-]+$"}, "detail": {"type": "string", "minLength": 1, "maxLength": 200}}}, {"type": "object", "additionalProperties": false, "required": ["code", "detail"], "properties": {"code": {"const": "TD_MORE"}, "detail": {"type": "string", "pattern": "^и ещё [0-9]+$"}}}]}}, "digest": {"$ref": "#/$defs/digest"}
  },
  "$defs": {"digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}}
}
